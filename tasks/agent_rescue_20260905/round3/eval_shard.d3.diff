         echo "[$(date -u +%H:%M:%S)] shard $SHARD cell $i: $STOCK $SEED step=${STEP:-final}"
         STOCK="$STOCK" SEED="$SEED" STEP="$STEP" bash "$S/eval_v5me4_cell.sh" \
