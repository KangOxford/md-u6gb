+# A .done is a manifest, not a flag.  `-f` accepts a 0-byte file, and a 0-byte .done
+# is what a redirection that succeeded followed by a writer that died leaves behind --
+# an allocation expiring mid-write produces exactly this.  Such a member is then
+# skipped on resume and scored as if it were complete.  Measured 2026-09-05: ten sites
+# tested .done with -f and none with -s.  Existence is not integrity.
+_done_ok() {
+    [ -s "$1/.done" ] || return 1
+    "$PYTHON" -c 'import json,sys; json.load(open(sys.argv[1]))' "$1/.done" 2>/dev/null
+}
