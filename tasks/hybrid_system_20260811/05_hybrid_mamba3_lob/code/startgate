#!/usr/bin/env python3
"""nodestat — 起跑前问清楚卡的状态，以及让锁自己过期。

这个工具是 2026-08-12 一整天反复手打同几段命令、又反复被同几件事咬到之后的产物。
它做三件 gtop 不做的事，并且与 gtop 共用同一个锁注册表，不另起一套。

  free   逐卡看我名下 RUNNING 分配的剩余显存。gtop 给的是人看的全景；这里给的是
         机器读的一行一卡，好让脚本据此挑卡。
  gate   起跑前的两道闸门合成一个命令：目标卡是不是真的空、宿主分配还能活多久。
  claim  带 TTL 的锁，以及把过期/失效的锁收掉。

--------------------------------------------------------------------------
为什么需要 TTL：gtop 的锁只有一条失效路径
--------------------------------------------------------------------------
gtop 的 lock_is_live 是：

    挂在 jobid 上的锁随 job 结束自动失效；手动锁（无 jobid）永久有效。

「永久有效」就是问题。手动锁没有任何东西会来收它，忘了就一直占着，而 gtop 会
如实把那张空卡显示成 lock，别的会话的自律闸门也就一直躲着它。今天 gtop 抬头
写的是 `held 5 idle 11 · idle draw 1.66 kW`——空转是有电费的。

--------------------------------------------------------------------------
为什么不做「5 分钟闲置就释放」
--------------------------------------------------------------------------
直觉上「卡上没进程 5 分钟就该还回去」很合理，但今天有一个直接的反例：

    bench 起跑后要挂 48 个 squashfs 分片、再等 XLA 编译，这段时间 GPU 上是
    3 MiB、零 compute 进程，持续约 10 分钟。

5 分钟的闲置释放会在启动中途把卡判给邻居——**正是这把锁存在的理由**。而且今天
实测过：手工清空四个节点后，别的会话在 90 秒内就把卡抢回去了。闲置判据太灵敏，
损失的正是它本该保护的那段。

所以三条释放路径按各自管的失效模式分开：

  绑作业（已有）  job 一离开 RUNNING 就失效。**默认且首选**，因为它精确：
                  作业还在就说明还需要卡，作业没了就一定不需要。
  TTL（新增）     无主锁默认 60 分钟过期，可续。管的是「人忘了」。
  闲置（新增）    只对**无主锁**生效，阈值 30 分钟。管的是「锁着但根本没在用」。
                  绑了活作业的锁不受闲置判据约束，因为启动、存点、评分之间的
                  空窗都是正常的。

三条都只改显示与各会话的自律，不真的阻止 CUDA 分配——与 gtop 的协作性一致。
"""
import argparse
import json
import os
import subprocess
import sys
import time

GTOP_DIR = "/projects/public/u6gb/.local/bin"
LOCKS_ENV = "GTOP_LOCKS"
DEFAULT_TTL_MIN = 60
IDLE_RELEASE_MIN = 30
RESIDUAL_MIB = 4096          # 一个 CUDA context 约 0.6 GB；4 GB 以下视为空
MIN_WALLTIME_MIN = 60


def locks_path():
    return os.environ.get(LOCKS_ENV) or os.path.join(GTOP_DIR, "gpu_locks.json")


def load_locks():
    try:
        with open(locks_path()) as f:
            return json.load(f).get("locks", [])
    except (OSError, ValueError):
        return []


def save_locks(locks):
    """tmp + os.replace，与 gtop 一致：注册表是共享文件，半个写入比没有更糟。"""
    path = locks_path()
    tmp = path + f".tmp{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump({"locks": locks}, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def sh(cmd, timeout=60):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True,
                           timeout=timeout)
        return r.stdout.strip()
    except Exception:
        return ""


def running_jobs():
    """{jobid: 剩余分钟}，只看自己的 RUNNING。"""
    out = sh('squeue -u "$USER" -h -t RUNNING -o "%i|%L|%N"')
    jobs = {}
    for line in out.splitlines():
        parts = line.split("|")
        if len(parts) < 3:
            continue
        jobs[parts[0].strip()] = (left_minutes(parts[1].strip()), parts[2].strip())
    return jobs


def left_minutes(s):
    """squeue %L 形如 D-HH:MM:SS / HH:MM:SS / MM:SS；UNLIMITED 记为很大。"""
    if not s or s.upper().startswith("UNLIM"):
        return 10 ** 6
    d = 0
    if "-" in s:
        head, s = s.split("-", 1)
        d = int(head)
    p = [int(x) for x in s.split(":")]
    while len(p) < 3:
        p.insert(0, 0)
    return d * 1440 + p[0] * 60 + p[1] + (1 if p[2] else 0)


def hosts_of(nodelist):
    out = sh(f'scontrol show hostnames "{nodelist}"')
    return [h for h in out.splitlines() if h.strip()]


def probe(jobid, host):
    """逐卡 (index, used_mib, n_pids)。走 srun --overlap，不打扰在跑的东西。"""
    cmd = (f'timeout 45 srun --jobid={jobid} --overlap --nodes=1 --ntasks=1 '
           f'-w {host} --cpu-bind=none bash -c '
           f'\'for i in 0 1 2 3; do '
           f'm=$(nvidia-smi -i $i --query-gpu=memory.used --format=csv,noheader,nounits); '
           f'p=$(nvidia-smi -i $i --query-compute-apps=pid --format=csv,noheader | wc -l); '
           f'echo "$i $m $p"; done\' 2>/dev/null')
    rows = []
    for line in sh(cmd, timeout=90).splitlines():
        f = line.split()
        if len(f) == 3 and f[0].isdigit():
            rows.append((int(f[0]), int(f[1]), int(f[2])))
    return rows


def iso_now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def age_min(iso):
    try:
        t = time.strptime(iso, "%Y-%m-%dT%H:%M:%SZ")
        return (time.time() - time.mktime(t) + time.timezone) / 60.0
    except Exception:
        return 0.0


# ---------------------------------------------------------------- free
def cmd_free(a):
    jobs = running_jobs()
    if not jobs:
        print("没有 RUNNING 的分配")
        return 0
    targets = {a.alloc: jobs[a.alloc]} if a.alloc and a.alloc in jobs else jobs
    print(f"{'alloc':<10}{'node':<12}{'gpu':<5}{'used MiB':>10}{'free MiB':>10}{'pids':>6}  状态")
    print("-" * 62)
    for jid, (left, nodelist) in sorted(targets.items()):
        for host in hosts_of(nodelist):
            for gi, used, npid in probe(jid, host):
                free = 95_600 - used          # GH200 96GB 卡，与 gtop 显示一致
                st = "空闲" if (used < RESIDUAL_MIB and npid == 0) else "占用"
                print(f"{jid:<10}{host:<12}{gi:<5}{used:>10}{free:>10}{npid:>6}  {st}")
    return 0


# ---------------------------------------------------------------- gate
def cmd_gate(a):
    """起跑前的两道闸门。它们回答**不同**的问题，缺一不可。

    物理闸门回答「卡是不是空的」。它挡不住的那种失败是：卡很空，因为宿主分配
    还有 18 分钟就到点了。2026-08-12 12:59:45 三个 bench 在同一秒集体死亡，
    就是这么来的——同一秒说明是一个外部事件，不是三次独立失败。

    时间闸门回答「这个分配还能活多久」。卡越空越该顺手问一句。
    """
    jobs = running_jobs()
    if a.alloc not in jobs:
        print(f"FATAL 分配 {a.alloc} 不在 RUNNING", file=sys.stderr)
        return 2
    left, _ = jobs[a.alloc]
    print(f"[gate] 宿主 {a.alloc} 剩余 {left} min（需 {a.min_walltime}）")
    if left < a.min_walltime:
        print(f"FATAL 只剩 {left} min，低于所需 {a.min_walltime} min。换一个分配。",
              file=sys.stderr)
        return 3

    want = [int(x) for x in a.gpus.split(",")] if a.gpus else [0, 1, 2, 3]
    rows = {gi: (used, npid) for gi, used, npid in probe(a.alloc, a.node)}
    if not rows:
        print(f"FATAL 读不到 {a.node} 的 GPU 状态", file=sys.stderr)
        return 4
    bad = []
    for gi in want:
        used, npid = rows.get(gi, (10 ** 9, 9))
        print(f"[gate] {a.node} GPU{gi} used={used} MiB pids={npid}")
        if used > a.max_residual or npid > 0:
            bad.append(gi)
    if bad:
        print(f"FATAL 目标卡 {bad} 上有别人的东西。中止，不动它。", file=sys.stderr)
        return 5

    # 锁是协作性的：别人声明过的卡，就算物理上空着也不该拿。
    for e in load_locks():
        if e.get("node") != a.node:
            continue
        g = e.get("gpus")
        clash = [x for x in want if g is None or x in g]
        if clash and e.get("jobid") != a.alloc:
            print(f"FATAL {a.node} GPU{clash} 已被 {e.get('who') or e.get('jobid') or '?'} "
                  f"声明（gtop lock）。中止。", file=sys.stderr)
            return 6
    print("[gate] 通过")
    return 0


# ---------------------------------------------------------------- claim
def cmd_claim(a):
    node, _, gspec = a.target.partition(":")
    gpus = [int(x) for x in gspec.split(",")] if gspec else None
    locks = [e for e in load_locks()
             if not (e.get("node") == node and e.get("gpus") == gpus)]
    ent = {"node": node, "gpus": gpus, "at": iso_now()}
    if a.job:
        ent["jobid"] = a.job
    if a.who:
        ent["who"] = a.who
    if a.note:
        ent["note"] = a.note
    # 绑了作业的锁由作业自己收尾，不需要 TTL；无主锁必须有。
    if not a.job:
        ent["ttl_min"] = a.ttl
    locks.append(ent)
    save_locks(locks)
    kind = f"随作业 {a.job} 失效" if a.job else f"TTL {a.ttl} min"
    print(f"claimed {node}:{gspec or 'all'}（{kind}）-> {locks_path()}")
    return 0


# ---------------------------------------------------------------- gc
def cmd_gc(a):
    """收掉三类锁，并说明各自的理由。默认只报告，--apply 才写回。"""
    locks = load_locks()
    if not locks:
        print(f"没有锁（{locks_path()}）")
        return 0
    jobs = running_jobs()
    keep, drop = [], []
    for e in locks:
        jid = e.get("jobid")
        if jid:
            if jid in jobs:
                keep.append(e)
            else:
                drop.append((e, f"作业 {jid} 已不在 RUNNING"))
            continue
        ttl = e.get("ttl_min", DEFAULT_TTL_MIN)
        age = age_min(e.get("at", ""))
        if age > ttl:
            drop.append((e, f"无主锁已 {age:.0f} min > TTL {ttl}"))
            continue
        keep.append(e)

    # 闲置判据只对无主锁生效。绑了活作业的卡在启动、存点、评分之间空窗是正常的：
    # 实测 bench 起跑时挂 48 个分片加 XLA 编译，GPU 上零进程可以持续约 10 分钟。
    if a.idle:
        still = []
        for e in keep:
            if e.get("jobid") or age_min(e.get("at", "")) < IDLE_RELEASE_MIN:
                still.append(e)
                continue
            alloc = next(iter(jobs), None)
            rows = probe(alloc, e["node"]) if alloc else []
            want = e.get("gpus") or [0, 1, 2, 3]
            busy = any(npid > 0 for gi, used, npid in rows if gi in want)
            if busy:
                still.append(e)
            else:
                drop.append((e, f"无主锁闲置 > {IDLE_RELEASE_MIN} min 且卡上无进程"))
        keep = still

    for e, why in drop:
        g = "all" if e.get("gpus") is None else ",".join(map(str, e["gpus"]))
        print(f"  收 {e.get('node')}:{g}  ({why})")
    print(f"{'已收' if a.apply else '可收'} {len(drop)}，保留 {len(keep)}")
    if a.apply and drop:
        save_locks(keep)
    elif drop:
        print("（这是预演；加 --apply 才写回）")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="nodestat", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("free", help="逐卡剩余显存")
    p.add_argument("--alloc", default=None)
    p.set_defaults(fn=cmd_free)

    p = sub.add_parser("gate", help="起跑前的物理 + 时间 + 锁 三道闸门")
    p.add_argument("--alloc", required=True)
    p.add_argument("--node", required=True)
    p.add_argument("--gpus", default=None, help="如 0,1；缺省 0,1,2,3")
    p.add_argument("--max-residual", type=int, default=RESIDUAL_MIB)
    p.add_argument("--min-walltime", type=int, default=MIN_WALLTIME_MIN)
    p.set_defaults(fn=cmd_gate)

    p = sub.add_parser("claim", help="带 TTL 的锁")
    p.add_argument("target", metavar="NODE[:GPUS]")
    p.add_argument("-j", "--job", default=None, help="绑作业；首选")
    p.add_argument("--ttl", type=int, default=DEFAULT_TTL_MIN, help="无主锁的过期分钟")
    p.add_argument("--who", default=None)
    p.add_argument("--note", default=None)
    p.set_defaults(fn=cmd_claim)

    p = sub.add_parser("gc", help="收掉失效/过期/闲置的锁")
    p.add_argument("--apply", action="store_true", help="真的写回；缺省只预演")
    p.add_argument("--idle", action="store_true",
                   help="额外按闲置收（只作用于无主锁，会 srun 探卡）")
    p.set_defaults(fn=cmd_gc)

    a = ap.parse_args()
    sys.exit(a.fn(a))


if __name__ == "__main__":
    main()
