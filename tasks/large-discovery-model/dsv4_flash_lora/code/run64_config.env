# 16 节点 64 卡 LoRA 的运行时配置 —— sbatch 作业启动那一刻才读取,
# 排队期间可以随时改这里而不用重新排队。
export EP_SIZE=16        # 256 专家 / 16 = 每卡 16 个专家,BF16 约 33G/卡
export GBS=64            # 必须整除 DP(=64)×MBS
export MBS=1
export DATASET_CAP=1000  # 每数据集条数(共 3 个数据集)
export TRAIN_ITERS=      # 空 = 完整 1 epoch(约 46 步)
export MTP_LAYERS=1
