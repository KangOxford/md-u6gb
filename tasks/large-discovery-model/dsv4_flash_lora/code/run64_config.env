# 16 节点 64 卡 LoRA 的运行时配置 —— sbatch 作业启动那一刻才读取,
# 排队期间可以随时改这里而不用重新排队。
export EP_SIZE=16        # 256 专家 / 16 = 每卡 16 个专家,BF16 约 33G/卡
export GBS=64            # 必须整除 DP(=64)×MBS
export MBS=1
# CAP 只决定 cached 数据目录名(data/cached_ds_cap<N>)。换 cap 之前必须先
# DATASET_CAP=<N> bash code/export_cached_ds.sh 离线建好——训练时不再碰原始数据集,
# 没有对应目录会 fail-fast(exit 6),不会再出现 64 rank 缓存竞态
# (6144379/6146475 两次都死在 datasets map 缓存的冷竞写上)。
export DATASET_CAP=600

export TRAIN_ITERS=      # 空 = 完整 1 epoch(约 46 步)
export MTP_LAYERS=1
