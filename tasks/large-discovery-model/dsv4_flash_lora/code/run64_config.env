# 16 节点 64 卡 LoRA 的运行时配置 —— sbatch 作业启动那一刻才读取,
# 排队期间可以随时改这里而不用重新排队。
export EP_SIZE=16        # 256 专家 / 16 = 每卡 16 个专家,BF16 约 33G/卡
export GBS=64            # 必须整除 DP(=64)×MBS
export MBS=1
# ⚠ CAP 只能用 600:datasets 的 map 缓存文件名含数据内容哈希,换 cap 等于指向
# 一套不存在的缓存 → 64 rank 同时抢写共享缓存目录,必发竞态
# (6144379 就是这么崩的:rank45 FileNotFoundError cache-*.arrow)。
# 要换 cap,先用单进程把新 cap 的缓存预热完再提交。
export DATASET_CAP=600   # 每数据集条数(共 3 个数据集);600 的缓存已由 mini/full16 冒烟建好

export TRAIN_ITERS=      # 空 = 完整 1 epoch(约 46 步)
export MTP_LAYERS=1
