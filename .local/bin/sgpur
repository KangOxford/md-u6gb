    "COMPLETED": "done", "RUNNING": "running", "FAILED": "FAILED",
    "TIMEOUT": "TIMEOUT", "CANCELLED": "cancelled", "NODE_FAIL": "NODE_FAIL",
    "OUT_OF_ME": "OOM", "PREEMPTED": "preempted", "REQUEUED": "requeued",
}

