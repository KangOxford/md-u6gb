<div id="app" hidden></div>"""

# Tooltip delegation binds at load (it is content-agnostic); the age clock has
# to wait until the decrypted markup is in the DOM, so it lives in initPage().
SHELL_JS = """
function initPage(){
  // Wall clock in the reader's zone, not the viewer's browser zone: every
  // timestamp on this page is already converted, so the clock must match them
  // even when opened from another country.
  var ck=document.getElementById('clock');
  if(ck){
    var o={timeZone:TZ_NAME,hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false};
    (function ct(){
      ck.textContent=new Date().toLocaleTimeString('en-GB',o);
      setTimeout(ct,1000);
    })();
  }
  // Every section that has something to forecast carries its own button, and
  // they all drive the one class, so whichever one you reach first flips the
  // whole page and the others follow.
  var fbs=[].slice.call(document.querySelectorAll('.fbtn'));
  fbs.forEach(function(fb){
    fb.addEventListener('click',function(){
      var on=document.body.classList.toggle('fc');
      fbs.forEach(function(x){
        x.textContent = on ? '\\u2190 back to now' : x.dataset.label;
      });
    });
  });
  initSearch();
  initRefresh();
  var born=SNAPSHOT_EPOCH, el=document.getElementById('age');
  if(!el) return;
  function fmt(s){
    if(s<60) return Math.max(0,Math.round(s))+'s ago';
    if(s<3600) return Math.round(s/60)+' min ago';
    if(s<86400) return (s/3600).toFixed(1)+' h ago';
    return (s/86400).toFixed(1)+' d ago';
  }
  function tick(){
    var s=Date.now()/1000-born;
    el.textContent=fmt(s);
    // "how old is this" and "am I fetching a newer one" are the same question
    // asked twice, so they share one element instead of growing a widget.
    var n=el.dataset.note;
    if(n){ var sp=document.createElement('span');
           sp.className='note'; sp.textContent=' \u00b7 '+n; el.appendChild(sp); }
    el.className = s<900?'fresh' : s<7200?'warm' : 'stale';
    el.title = s<900?'fresh' : 'run sgpur again to refresh';
  }
  tick(); setInterval(tick,1000); window.sgpurAgeTick=tick;
}
// Search over everything the page already knows.  The haystack is each row's
// visible text PLUS every data-tip inside it, because the tips are where the
// job ids, node names, exact times and full command lines live -- searching
// only what is painted would miss most of what people come here to find.
//
// The ruler rows are filtered out by hand.  ruler_html() emits class="row"
// exactly like the data rows, and it IS the shared time axis: hide it and
// every chart below loses its x-axis with nothing to say why.
// Nothing can reach the login node -- it has no public entrance.  So the
// button does not command the terminal, it leaves a note in a Cloudflare
// mailbox that the terminal walks out to collect every few seconds.  Both
// halves poll; neither listens.
//
// The button is the only thing on this page that asks the cluster for
// anything.  Cmd+R deliberately is not: reloading means "show me this page
// again", it is how you re-read what is already here, and it also fires for a
// bookmark, a restored tab and the back button.  Hanging one sacct and one
// srun off that gesture makes re-reading cost a cluster sample, which is the
// opposite of what the gesture means.  Reading stays free; only a click spends.
//
// Why it cannot be instant: the snapshot does not exist yet when you press.
// Producing it costs one sacct and one srun, so it happens once per click and
// never on a timer.
function initRefresh(){
  var b=document.getElementById('rbtn');
  if(!b) return;
  var url=b.dataset.url, tok=b.dataset.token, base=BUILD_STAMP, t0=0;
  function set(s,txt){ if(s) b.dataset.s=s; else b.removeAttribute('data-s');
                       b.textContent=txt; }
  // Watch this page's own build stamp: same origin, so no CORS, and it is the
  // one signal that survives the CDN.  A newer stamp means the terminal
  // answered and surge has already served the new bytes.
  function poll(){
    var wait=Math.round((Date.now()-t0)/1000);
    if(wait>300){ set('fail','↻ no answer — is sgpur -w running?'); return; }
    set('wait','waiting for the terminal… '+wait+'s');
    // The build stamp sits in the first 400 bytes, so read 400 bytes rather
    // than the whole 100 KB page -- 258x less over a 90 s wait.  If anything in
    // the path ignores Range the full page comes back and the match still works.
    fetch(location.pathname+'?_='+Date.now(),
          {cache:'no-store',headers:{'Range':'bytes=0-399'}})
      .then(function(r){ return r.text() })
      .then(function(t){
        var m=t.match(/name="build" content="(\\d+)"/);
        if(m && (+m[1])>base){
          set('wait','new snapshot — reloading…');
          setTimeout(function(){ location.reload() },400);
        } else setTimeout(poll,4000);
      })
      .catch(function(){ setTimeout(poll,6000) });
  }
  b.addEventListener('click',function(){
    if(b.dataset.s==='wait') return;
    t0=Date.now(); set('wait','requesting…');
    // The Worker authenticates the same way for browsers and the login node: a
    // private x-token header.  Its OPTIONS route explicitly allows this
    // preflight, so the token never appears in a URL, browser history or
    // intermediary request log.
    fetch(url,{method:'POST',mode:'cors',headers:{'x-token':tok}})
      .then(function(r){
        if(!r.ok) throw new Error('HTTP '+r.status);
        return r.text();
      })
      .then(function(){ poll() })
      .catch(function(){ set('fail','↻ mailbox unreachable') });
  });
}

function initSearch(){
  var box=document.getElementById('q'), out=document.getElementById('qn');
  if(!box) return;
  var rows=[].slice.call(document.querySelectorAll('.row,.hrow,.lrow,details'))
    .filter(function(r){ return !r.querySelector('.track.ruler'); });
  rows.forEach(function(r){
    var t=r.textContent||'';
    if(r.getAttribute('data-tip')) t+=' '+r.getAttribute('data-tip');
    [].slice.call(r.querySelectorAll('[data-tip]')).forEach(function(e){
      t+=' '+e.getAttribute('data-tip');
    });
    r.setAttribute('data-hay',t.toLowerCase().replace(/\\s+/g,' '));
  });
  var secs=[].slice.call(document.querySelectorAll('section'));
  function apply(){
    var q=box.value.toLowerCase().trim();
    var terms=q?q.split(/\\s+/):[];
    var pos=terms.filter(function(t){return t.charAt(0)!=='-'&&t.length;});
    var neg=terms.filter(function(t){return t.charAt(0)==='-'&&t.length>1;})
                 .map(function(t){return t.slice(1);});
    var shown=0;
    rows.forEach(function(r){
      var h=r.getAttribute('data-hay')||'';
      var ok=pos.every(function(t){return h.indexOf(t)>=0;})
          && !neg.some(function(t){return h.indexOf(t)>=0;});
      r.classList.toggle('qhide',!ok);
      if(ok) shown++;
    });
    // Per-section counts: an empty chart with no explanation reads as a bug.
    secs.forEach(function(sec){
      var h2=sec.querySelector('h2'); if(!h2) return;
      var tag=h2.querySelector('.qn');
      if(!q){ if(tag) tag.remove(); return; }
      var n=0;
      rows.forEach(function(r){ if(sec.contains(r)&&!r.classList.contains('qhide')) n++; });
      if(!tag){ tag=document.createElement('span'); tag.className='qn';
                h2.appendChild(tag); }
      tag.textContent=n+' match'+(n===1?'':'es');
      tag.className='qn'+(n?'':' zero');
    });
    out.textContent = q ? (shown+' row'+(shown===1?'':'s')) : '';
  }
  box.addEventListener('input',apply);
  box.addEventListener('keydown',function(e){
    if(e.key==='Escape'){ box.value=''; apply(); box.blur(); }
  });
  document.addEventListener('keydown',function(e){
    if(e.key==='/'&&document.activeElement!==box){ e.preventDefault(); box.focus(); }
  });
}

(function(){
  var tip=document.getElementById('tip');
  document.addEventListener('mouseover',function(e){
    var t=e.target.closest('[data-tip]'); if(!t) return;
    tip.textContent=t.getAttribute('data-tip'); tip.style.display='block';
  });
  document.addEventListener('mousemove',function(e){
    if(tip.style.display!=='block') return;
    var w=tip.offsetWidth,h=tip.offsetHeight,x=e.clientX+14,y=e.clientY+16;
    if(x+w>innerWidth-8) x=e.clientX-w-14;
    if(y+h>innerHeight-8) y=e.clientY-h-16;
    tip.style.left=Math.max(8,x)+'px'; tip.style.top=Math.max(8,y)+'px';
  });
  document.addEventListener('mouseout',function(e){
    if(e.target.closest('[data-tip]')) tip.style.display='none';
  });
})();
"""

# A wrong passphrase does not "fail a check" -- AES-GCM's authentication tag
# makes decrypt() throw.  There is no branch that could be patched out client
# side, and no plaintext anywhere in the file to recover.
GATE_JS = """
(function(){
  var P=PAYLOAD, LSK='sgpur.k.'+P.k;
  var gate=document.getElementById('gate'), app=document.getElementById('app'),
      form=document.getElementById('gform'), pw=document.getElementById('pw'),
      rem=document.getElementById('rem'), msg=document.getElementById('msg'),
      btn=document.getElementById('btn');

  function u8(b64s){var s=atob(b64s),u=new Uint8Array(s.length);
    for(var i=0;i<s.length;i++)u[i]=s.charCodeAt(i);return u}
  function b64(buf){var s='',u=new Uint8Array(buf);
    for(var i=0;i<u.length;i++)s+=String.fromCharCode(u[i]);return btoa(s)}

  async function derive(pass){
    var km=await crypto.subtle.importKey('raw',new TextEncoder().encode(pass),
      'PBKDF2',false,['deriveBits']);
    return crypto.subtle.deriveBits(
      {name:'PBKDF2',salt:u8(P.s),iterations:P.n,hash:'SHA-256'},km,256);
  }
  async function open_(bits){
    var key=await crypto.subtle.importKey('raw',bits,'AES-GCM',false,['decrypt']);
    var pt=await crypto.subtle.decrypt({name:'AES-GCM',iv:u8(P.i)},key,u8(P.c));
    var st=new Blob([pt]).stream().pipeThrough(new DecompressionStream('gzip'));
    return new Response(st).text();
  }
  function reveal(html){
    gate.style.display='none'; app.innerHTML=html; app.hidden=false; initPage();
  }
  function busy(on,text){
    btn.disabled=on; msg.className=on?'msg work':'msg'; msg.textContent=text||'';
  }

  // A stored key skips both the prompt and the 600k-iteration derivation.
  (async function(){
    var saved=null; try{saved=localStorage.getItem(LSK)}catch(e){}
    if(!saved) return;
    try{ reveal(await open_(u8(saved).buffer)); }
    catch(e){ try{localStorage.removeItem(LSK)}catch(_){} }
  })();

  form.addEventListener('submit',async function(e){
    e.preventDefault();
    if(!pw.value) return;
    busy(true,'deriving key\\u2026');
    try{
      var bits=await derive(pw.value);
      var html=await open_(bits);
      if(rem.checked){ try{localStorage.setItem(LSK,b64(bits))}catch(_){} }
      busy(false,''); reveal(html);
    }catch(err){
      // Distinguish the three failures.  Reporting a missing browser API as
      // "wrong passphrase" makes people retype a correct passphrase forever.
      busy(false,'');
      if(!(window.crypto&&crypto.subtle))
        msg.textContent='This browser blocks WebCrypto (page must be HTTPS).';
      else if(typeof DecompressionStream==='undefined')
        msg.textContent='Browser too old: needs DecompressionStream (Chrome 80+, Safari 16.4+).';
      else
        msg.textContent='Wrong passphrase.';
      pw.select();
    }
  });
})();
"""


def _page(head_title: str, inner: str, script: str, epoch: float = 0) -> str:
    # A page whose script throws on load still looks entirely correct: the
    # markup renders, and only the parts that needed a handler are quietly
    # dead.  On 2026-08-14 initPage() called an initSearch() that had been
    # deleted alongside a neighbouring edit, and the ReferenceError killed
    # every line after it -- the refresh button never bound its click, the age
    # clock never started, the search box stayed inert -- while the page still
    # showed the right numbers and the publishing terminal reported success.
    # There was nothing to notice.  So check here, on the one path every page
    # leaves by, that the script defines what it calls.
    defined = set(re.findall(r"^function (\w+)", script, re.M))
    missing = sorted(set(re.findall(r"^\s*(init\w+)\(\)", script, re.M)) - defined)
    if missing:
        raise RuntimeError(
            f"page script calls {', '.join(missing)} but does not define "
            f"{'them' if len(missing) > 1 else 'it'}: the page would render "
            f"correctly and then do nothing at all")
    # The build stamp is the only way the browser can tell that the terminal
    # answered its refresh request: it re-fetches this page (same origin, no
    # CORS) and compares.  Plaintext on purpose -- it is a unix timestamp, and
    # the unlocked page already shows the snapshot age to anyone who asks.
    return (f"<!doctype html>\n<html lang=en><head><meta charset=utf-8>"
            f'<meta name="viewport" content="width=device-width,initial-scale=1">'
            f'<meta name="robots" content="noindex,nofollow">'
            f'<meta name="build" content="{epoch:.0f}">'
            f"<title>{esc(head_title)}</title>"
            f"<style>{CSS}{GATE_CSS}</style></head><body>"
            f'{inner}<div id="tip"></div>'
            f"<script>{script}</script></body></html>\n")


def shell_js(epoch: float) -> str:
    return (SHELL_JS.replace("SNAPSHOT_EPOCH", f"{epoch:.0f}")
                    .replace("BUILD_STAMP", f"{epoch:.0f}")
                    .replace("TZ_NAME", json.dumps(str(DISPLAY_TZ))))


def page_plain(body: str, title: str, epoch: float) -> str:
    return _page(title, body, shell_js(epoch), epoch)


def page_locked(payload: dict, epoch: float) -> str:
    """The shell carries no job id, no node name, no path, no user name.

    Title is deliberately generic: a bystander glancing at the browser tab
    learns nothing, and the unlocked h1 with the real name lives inside the
    ciphertext.
    """
    js = (shell_js(epoch)
          + GATE_JS.replace("PAYLOAD", json.dumps(payload, separators=(",", ":"))))
    return _page("GPU time ledger", GATE_HTML, js, epoch)


def encrypt_body(body: str, password: str, salt: bytes) -> dict:
    """gzip then AES-256-GCM.  Compressing first matters: base64 of raw
    ciphertext is incompressible, so without it the CDN ships ~4x the bytes."""
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    key = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, PBKDF2_ITERS, 32)
    iv = os.urandom(12)
    ct = AESGCM(key).encrypt(iv, gzip.compress(body.encode(), 9), None)
    return {"s": base64.b64encode(salt).decode(),
            "i": base64.b64encode(iv).decode(),
            "c": base64.b64encode(ct).decode(),
            "n": PBKDF2_ITERS,
            "k": hashlib.sha256(salt).hexdigest()[:12]}


def load_secret() -> tuple[str, bytes] | None:
    """Password plus a STABLE salt.

    The salt is stored, not regenerated per deploy, on purpose: the browser
    caches the derived key under a salt-derived id, so a rotating salt would
    invalidate every reader's saved key on every refresh.  A fixed salt still
    defeats precomputation, which is all a salt is for here.
    """
    env_pw = os.environ.get("SGPUR_PASSWORD")
    if os.path.exists(SECRET_PATH):
        with open(SECRET_PATH) as f:
            d = json.load(f)
        return env_pw or d["password"], base64.b64decode(d["salt"])
    if env_pw:
        return env_pw, hashlib.sha256(b"sgpur-static-salt|" + env_pw.encode()).digest()[:16]
    return None


def set_password() -> int:
    import getpass
    old = None
    if os.path.exists(SECRET_PATH):
        with open(SECRET_PATH) as f:
            old = json.load(f)
    pw = getpass.getpass("new passphrase: ")
    if len(pw) < 8:
        print("sgpur: use at least 8 characters -- the ciphertext is public, "
              "so a short passphrase can be attacked offline", file=sys.stderr)
        return 1
    if pw != getpass.getpass("again: "):
        print("sgpur: they do not match", file=sys.stderr)
        return 1
    # Reuse the existing salt so already-unlocked browsers stay unlocked.
    salt = base64.b64decode(old["salt"]) if old else os.urandom(16)
    os.makedirs(os.path.dirname(SECRET_PATH), exist_ok=True)
    with open(SECRET_PATH, "w") as f:
        json.dump({"password": pw, "salt": base64.b64encode(salt).decode()}, f)
    os.chmod(SECRET_PATH, 0o600)
    print(f"sgpur: passphrase saved to {SECRET_PATH} (mode 600)")
    print("  every `sgpur` from now on publishes an encrypted page")
    if old and old["password"] != pw:
        print("  NOTE: readers who ticked 'remember' must enter the new one once")
    return 0


SKILL_MD = "/projects/public/u6gb/.claude/skills/surge/SKILL.md"


def find_token() -> tuple[str, str] | None:
    """Locate surge credentials without ever hardcoding them here."""
    login = os.environ.get("SURGE_LOGIN")
    token = os.environ.get("SURGE_TOKEN")
    if login and token:
        return login, token
    try:
        import re
        txt = open(SKILL_MD).read()
        m1 = re.search(r'SURGE_LOGIN="([^"]+)"', txt)
        m2 = re.search(r'SURGE_TOKEN="([0-9a-fA-F]{16,})"', txt)
        if m1 and m2:
            return m1.group(1), m2.group(1)
    except OSError:
        pass
    return None


def setup_credentials() -> int:
    """Repair ~/.netrc so plain `sgpur` deploys with no environment variables.

    The existing surge entries carry a `login` line but no `password` line, so
    the CLI finds the machine, fails to find a token, and falls back to an
    interactive prompt that cannot be answered from a script.  Appending a
    fresh block would not help: netrc readers take the first matching machine,
    which is the broken one.  The password line has to be inserted into the
    entry that is already there.
    """
    creds = find_token()
    if not creds:
        print("sgpur --setup: no token found.\n"
              "  export SURGE_LOGIN=<email> SURGE_TOKEN=<token> and re-run,\n"
              "  or get a token with `surge token`.", file=sys.stderr)
        return 1
    login, token = creds

    path = os.path.expanduser("~/.netrc")
    lines = open(path).read().splitlines() if os.path.exists(path) else []
    backup = path + ".bak." + time.strftime("%Y%m%dT%H%M%S")
    if lines:
        shutil.copy2(path, backup)

    out, machine, patched = [], None, []
    for i, ln in enumerate(lines):
        out.append(ln)
        f = ln.split()
        if f and f[0] == "machine":
            machine = f[1]
        if f and f[0] == "login" and machine in ("surge.sh", "surge.surge.sh"):
            nxt = lines[i + 1].split() if i + 1 < len(lines) else []
            if not (nxt and nxt[0] == "password"):
                indent = ln[:len(ln) - len(ln.lstrip())]
                out.append(f"{indent}password {token}")
                patched.append(machine)
    if not patched and not any(l.split()[1:2] == ["surge.sh"]
                               for l in lines if l.split()[:1] == ["machine"]):
        out += ["machine surge.sh", f"  login {login}", f"  password {token}",
                "machine surge.surge.sh", f"  login {login}", f"  password {token}"]
        patched = ["surge.sh", "surge.surge.sh (created)"]

    if not patched:
        print("sgpur --setup: ~/.netrc already has a surge password, nothing to do")
        return 0
    with open(path, "w") as f:
        f.write("\n".join(out) + "\n")
    os.chmod(path, 0o600)
    print(f"sgpur --setup: added password to {', '.join(patched)} in {path}")
    print(f"  backup: {backup}   mode 600")
    print("  now just run: sgpur")
    return 0


# surge's publish endpoint, spoken directly rather than through surge(1).
SURGE_ENDPOINT = os.environ.get("SGPUR_SURGE_ENDPOINT", "https://surge.surge.sh")
# Sent as the `version` header; the server reads it.  This is the CLI release
# the wire format below was read out of, so it is what the server expects.
SURGE_PROTO_VERSION = "0.27.4"
# How long the server asked us to wait, set by deploy_native() and read by
# watch_loop().  A module global rather than a wider return type because
# `publish_once() -> int` is load-bearing in three call sites and only one
# deploy is ever in flight, so there is nothing here to race.
LAST_RETRY_AFTER: float | None = None
# Why the last deploy failed, for the same reason and with the same caveats.
# Held rather than printed at the point of failure so publish_once() can erase
# its "uploading…" line first; writing it from inside deploy() lands it on top
# of that line and the erase then chews the error message instead.
LAST_DEPLOY_DETAIL = ""


def netrc_token() -> tuple[str, str] | None:
    """The surge entry in ~/.netrc, the credential store surge(1) reads.

    find_token() covers the environment and the skill file.  This is the third
    place a token can live, and without it the native path would fail on a
    machine where only `surge login` was ever run -- a regression against the
    CLI, which reads netrc itself.
    """
    path = os.path.expanduser("~/.netrc")
    try:
        with open(path) as f:
            fields = f.read().split()
    except OSError:
        return None
    machine, login, password = None, None, None
    for i, tok in enumerate(fields):
        nxt = fields[i + 1] if i + 1 < len(fields) else None
        if tok == "machine":
            if machine in ("surge.sh", "surge.surge.sh") and login and password:
                return login, password
            machine, login, password = nxt, None, None
        elif tok == "login":
            login = nxt
        elif tok == "password":
            password = nxt
    if machine in ("surge.sh", "surge.surge.sh") and login and password:
        return login, password
    return None


def surge_tar(site_dir: str) -> tuple[bytes, int, int]:
    """The gzip tar surge expects, byte-faithful to what its own CLI sends.

    Entries are named "<basename(site_dir)>/<file>" because the server strips
    one leading path component, and carry mtime 0 under USTAR headers, which is
    what node-tar's `portable: true` produces (surge-stream/lib/stream.js:113).
    Deviating here gets rejected with exactly the blank error the native path
    exists to avoid, so it is worth matching precisely.

    Returns (gzipped tar, file count, uncompressed bytes); the latter two go
    out as headers the server cross-checks against the body.
    """
    import io
    import tarfile
    site_dir = os.path.abspath(site_dir.rstrip("/"))
    prefix = os.path.basename(site_dir)
    raw, count, size = io.BytesIO(), 0, 0
    with tarfile.open(fileobj=raw, mode="w", format=tarfile.USTAR_FORMAT) as tf:
        for name in sorted(os.listdir(site_dir)):
            path = os.path.join(site_dir, name)
            if not os.path.isfile(path):
                continue
            with open(path, "rb") as f:
                data = f.read()
            ti = tarfile.TarInfo(f"{prefix}/{name}")
            ti.size, ti.mtime, ti.mode = len(data), 0, 0o644
            ti.uid = ti.gid = 0
            ti.uname = ti.gname = ""
            tf.addfile(ti, io.BytesIO(data))
            count, size = count + 1, size + len(data)
    out = io.BytesIO()
    with gzip.GzipFile(fileobj=out, mode="wb", mtime=0) as g:
        g.write(raw.getvalue())
    return out.getvalue(), count, size


def deploy_native(site_dir: str, domain: str) -> tuple[int, str]:
    """Publish straight at surge's endpoint, keeping the HTTP status code.

    surge(1) cannot report why a publish failed.  On the publish path
    surge-stream names only 401/403/422 (lib/stream.js:139-143) and folds every
    other status into a bare `emit("fail")` carrying no payload (:189-204); the
    CLI's own fail handler then discards even that argument
    (surge/lib/middleware/deploy.js:246).  So a 429 -- a status surge itself
    enumerates 120 lines earlier, in lib/stream.js config.defaults -- reaches
    the user as "Deployment did not succeed.": a sentence with no number in it
    and no Retry-After.  On 2026-08-14 that left this tool failing for two
    hours with nothing to act on, and by the time anything could be probed the
    window had closed and it no longer reproduced.

    Forty lines of HTTP buys the status code back.  Returns (rc, detail) with
    rc 0 ok / 1 transient / 2 misconfigured, and sets LAST_RETRY_AFTER when the
    server named a wait.
    """
    global LAST_RETRY_AFTER
    import urllib.error
    import urllib.request

    LAST_RETRY_AFTER = None
    creds = find_token() or netrc_token()
    if not creds:
        return 2, ("no surge credentials found; export SURGE_LOGIN and "
                   "SURGE_TOKEN, or run `sgpur --setup`")
    login, token = creds

    try:
        body, count, size = surge_tar(site_dir)
    except OSError as e:
        return 2, f"cannot read {site_dir}: {e}"
    if not count:
        return 2, f"nothing to publish: {site_dir} holds no files"

    auth = base64.b64encode(f"token:{token}".encode()).decode()
    req = urllib.request.Request(
        f"{SURGE_ENDPOINT.rstrip('/')}/{domain}", data=body, method="PUT",
        headers={
            "Authorization": "Basic " + auth,
            "content-type": "application/gzip",
            "accept": "application/x-ndjson",
            "version": SURGE_PROTO_VERSION,
            "file-count": str(count),
            "project-size": str(size),
            "cmd": "surge",
            "timestamp": datetime.now(ZoneInfo("UTC"))
                                 .isoformat().replace("+00:00", "Z"),
            "Content-Length": str(len(body)),
            "User-Agent": f"surge/{SURGE_PROTO_VERSION}",
        })

    # The server answers with an NDJSON event stream.  Receiving a line of
    # type "info" is what surge itself treats as "the publish was accepted"
    # (stream.js:127 sets its success flag there and nowhere else), so use the
    # same bar rather than inventing a stricter one that could reject a
    # publish the service considers done.
    accepted, server_said = False, ""
    try:
        with urllib.request.urlopen(req, timeout=300) as r:
            for line in r:
                line = line.decode(errors="replace").strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                kind = obj.get("type")
                if kind == "info":
                    accepted = True
                elif kind in ("error", "fail"):
                    server_said = str(obj)[:200]
            status = r.status
    except urllib.error.HTTPError as e:
        detail = ""
        try:
            detail = e.read().decode(errors="replace").strip()[:200]
        except Exception:
            pass
        retry = e.headers.get("Retry-After") if e.headers else None
        if retry:
            try:
                LAST_RETRY_AFTER = float(retry)
            except ValueError:
                LAST_RETRY_AFTER = None
        hint = {
            401: "  the token is not valid; run `surge login` or `sgpur --setup`",
            403: f"  this account cannot publish to {domain}",
            429: "  surge is rate-limiting publishes to this account",
            417: "  surge wants a paid plan for this",
            426: "  surge wants a newer client",
        }.get(e.code, "")
        rc = 2 if e.code in (401, 403, 417, 426) else 1
        msg = f"surge refused the publish: HTTP {e.code} {e.reason}"
        if retry:
            msg += f", Retry-After {retry}s"
        if hint:
            msg += "\n" + hint
        if detail:
            msg += f"\n  server said: {detail}"
        return rc, msg
    except urllib.error.URLError as e:
        return 1, f"could not reach {SURGE_ENDPOINT}: {e.reason!r}"
    except TimeoutError:
        return 1, "surge did not answer within 300s"

    if not accepted:
        # A 2xx whose stream never carried an "info" line.  This is the exact
        # shape the CLI renders as "Deployment did not succeed."; say what it
        # actually was instead.
        msg = (f"surge accepted the connection (HTTP {status}) but never "
               f"confirmed the publish")
        if server_said:
            msg += f"\n  server said: {server_said}"
        return 1, msg
    return 0, f"published {count} file(s), {size} B, as {login}"


def deploy(site_dir: str, domain: str) -> int:
    """Publish.  Native by default; SGPUR_DEPLOY=cli shells out to surge(1).

    The fallback is kept because the native path reimplements a wire format
    read out of a third-party package.  If surge ever changes it, the CLI is
    the escape hatch that still works -- at the cost of the blank errors.
    """
    global LAST_DEPLOY_DETAIL
    LAST_DEPLOY_DETAIL = ""
    if os.environ.get("SGPUR_DEPLOY", "native").lower() == "cli":
        return deploy_cli(site_dir, domain)
    rc, detail = deploy_native(site_dir, domain)
    if rc != 0:
        LAST_DEPLOY_DETAIL = detail
    return rc


def deploy_cli(site_dir: str, domain: str) -> int:
    exe = shutil.which("surge") or "/projects/public/u6gb/.bun/bin/surge"
    if not os.path.exists(exe):
        print("sgpur: surge CLI not found", file=sys.stderr)
        return 1
    env = dict(os.environ)
    # Credential order: explicit env > ~/.netrc (surge reads it itself) >
    # the token recorded in the surge skill.  The last one is the fallback
    # that makes a bare `sgpur` work on a machine whose netrc is incomplete.
    if not (env.get("SURGE_LOGIN") and env.get("SURGE_TOKEN")):
        creds = find_token()
        if creds:
            env["SURGE_LOGIN"], env["SURGE_TOKEN"] = creds
    try:
        p = subprocess.run([exe, ".", domain], cwd=site_dir, env=env,
                           capture_output=True, text=True, timeout=300)
    except subprocess.TimeoutExpired:
        print("sgpur: surge timed out after 300s", file=sys.stderr)
        return 1
    out = (p.stdout or "") + (p.stderr or "")
    if p.returncode != 0 or "Success" not in out:
        sys.stderr.write(out)
        if "Unauthorized" in out or "email" in out.lower():
            sys.stderr.write("\nsgpur: surge is not logged in. Either run "
                             "`surge login`, or export SURGE_LOGIN / "
                             "SURGE_TOKEN before calling sgpur.\n")
        return p.returncode or 1
    return 0


def surge_env() -> dict:
    env = dict(os.environ)
    if not (env.get("SURGE_LOGIN") and env.get("SURGE_TOKEN")):
        creds = find_token()
        if creds:
            env["SURGE_LOGIN"], env["SURGE_TOKEN"] = creds
    return env


def teardown(domain: str) -> int:
    exe = shutil.which("surge") or "/projects/public/u6gb/.bun/bin/surge"
    p = subprocess.run([exe, "teardown", domain], env=surge_env(),
                       capture_output=True, text=True, timeout=120)
    out = (p.stdout or "") + (p.stderr or "")
    if p.returncode != 0 or "Success" not in out:
        sys.stderr.write(out)
        return p.returncode or 1
    print(f"sgpur: {domain} torn down; the url now serves nothing")
    return 0


def publish_once(opts) -> int:
    """One full cycle: resample sacct, render, encrypt, upload.

    Return 0 on success, 1 on a transient failure (worth pressing r again),
    2 on misconfiguration (pressing r again will not help).
    """
    snap = S.collect(opts)
    if snap.err:
        print(f"sgpur: sacct failed: {snap.err}", file=sys.stderr)
        return 1
    if not snap.live and not snap.pending:
        print(f"sgpur: no jobs for {opts.user} in the last {opts.window}",
              file=sys.stderr)
        return 1

    live, live_err = (None, "skipped (--no-live)")
    if not opts.no_live:
        if opts.watch:
            print("  sampling GPUs…", end="", flush=True)
        live, live_err = collect_live(opts)
        if opts.watch:
            print("\r" + " " * 20 + "\r", end="")

    body = render_body(snap, opts, live, live_err)
    epoch = time.time()
    secret = None if opts.no_encrypt else load_secret()
    if secret:
        pw, salt = secret
        payload = encrypt_body(body, pw, salt)
        page = page_locked(payload, epoch)
        lock = (f"locked  ({len(body) / 1024:.0f} KB plaintext -> "
                f"{len(payload['c']) * 3 / 4 / 1024:.0f} KB ciphertext)")
    elif opts.no_encrypt:
        page = page_plain(body, page_title(opts), epoch)
        lock = "PUBLIC -- anyone with the url reads job ids, nodes and paths"
    else:
        # Refusing beats a silent plaintext publish: the page carries job ids,
        # node names and Lustre paths, and surge urls are guessable enough.
        print("sgpur: no passphrase set, refusing to publish in the clear.\n"
              "  set one:            sgpur --set-password\n"
              "  or publish openly:  sgpur --no-encrypt", file=sys.stderr)
        return 2

    os.makedirs(SITE_DIR, exist_ok=True)
    index = os.path.join(SITE_DIR, "index.html")
    with open(index, "w") as f:
        f.write(page)
    if opts.out:
        with open(opts.out, "w") as f:
            f.write(page)

    if opts.no_deploy:
        print(index)
        print(f"  {lock}")
        return 0

    if opts.watch:
        print("  uploading…", end="", flush=True)
    rc = deploy(SITE_DIR, opts.domain)
    if opts.watch:
        print("\r" + " " * 16 + "\r", end="", flush=True)
    if rc != 0:
        if LAST_DEPLOY_DETAIL:
            print(f"sgpur: {LAST_DEPLOY_DETAIL}", file=sys.stderr)
        print(f"sgpur: deploy failed; page is at {index}", file=sys.stderr)
        return rc if rc == 2 else 1

    url = f"https://{opts.domain}"
    if opts.quiet:
        print(url)
        return 0

    alloc = busy = 0.0
    for j in snap.live:
        for sg in j.segments:
            if sg.kind == "pending":
                continue
            alloc += gh(sg.secs, sg.alloc_gpus)
            if sg.kind == "busy":
                busy += gh(sg.secs, sg.gpus)
    print(f"{url}")
    print(f"  {L(snap.now):%H:%M:%S %Z} · {opts.window} · "
          f"{len(snap.live)} allocations · {len(snap.hist)} experiments · "
          f"{busy:.0f}/{alloc:.0f} GPU-h computed "
          f"({busy / alloc * 100 if alloc else 0:.1f}%)")
    print(f"  {lock}")
    return 0


def read_key(timeout=None) -> str:
    """One keypress, no Enter needed.  Empty string if `timeout` elapses.

    Returns 'q' when stdin is not a tty, so --watch can never wedge a
    non-interactive run (cron, pipe, nohup) in an unanswerable prompt.

    Returns "\\x04" at end of input, which is distinct from the "" that means
    the timeout ran out.  They used to be the same value and they must not be:
    a closed pty (ssh dropped, terminal killed) stays *readable* forever, so
    select returns immediately and read() keeps handing back nothing.  The
    mailbox branch of watch_loop spins on `while not k`, which would turn that
    into a busy loop walking out to the Worker on every pass.  \\x04 already
    means end-of-transmission and is already in the caller's quit set.
    """
    if not sys.stdin.isatty():
        return "q"
    import select
    import termios
    import tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        if timeout is not None:
            r, _, _ = select.select([fd], [], [], timeout)
            if not r:
                return ""
        # os.read, not sys.stdin.read: select reports on the kernel's buffer,
        # but sys.stdin is a buffered TextIOWrapper whose read(1) pulls a whole
        # chunk into userspace and returns one character of it.  The remainder
        # then sits where select cannot see it, so every later call times out
        # while bytes are already waiting.  Reading the fd keeps the readiness
        # test and the read looking at the same buffer.  latin-1 because any
        # byte must decode to exactly one character; this is a key, not text.
        b = os.read(fd, 1)
        return b.decode("latin-1") if b else "\x04"
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def self_mtime() -> float:
    try:
        return os.path.getmtime(os.path.abspath(__file__))
    except OSError:
        return 0.0


def watch_loop(opts) -> int:
    """Stay in the foreground and republish on demand.

    Deliberately keypress-driven rather than on a timer: BriCS forbids
    unattended pollers on login nodes, and one refresh per keypress, in a
    process the user is looking at, is a person doing it by hand.
    """
    rc = 0
    born = self_mtime()
    last_pub = 0.0
    fail_streak = 0
    backoff_until = 0.0
    trigger = "startup"
    ignored = 0
    while True:
        # Name what asked for this republish.  On 2026-08-14 a -w session
        # republished every 30 s for hours with nobody at the keyboard, and the
        # transcript could not tell a keypress from the mailbox from a closed
        # pty handing back nothing -- three causes with three different fixes,
        # and no way to choose between them after the fact.  One line makes the
        # next occurrence self-diagnosing.
        if trigger != "startup":
            print(f"  \033[2mrefresh: {trigger}\033[0m", flush=True)
        hold = backoff_until - time.time()
        if hold > 0:
            print(f"  \033[33mholding {hold:.0f}s before retrying "
                  f"([r] retry now, [q] quit)\033[0m", flush=True)
            deadline = time.time() + hold
            while True:
                left = deadline - time.time()
                if left <= 0:
                    break
                held_k = read_key(left)
                if held_k in ("q", "Q", "\x03", "\x04"):
                    print("  bye")
                    return rc
                if held_k in ("r", "R"):
                    break
                # Every other byte waits the hold out.  Cutting a backoff short
                # is the one thing it exists to prevent, so a byte nobody typed
                # does not get to make that call.
        rc = publish_once(opts)
        last_pub = time.time()
        if rc == 2:
            return rc
        if rc == 0:
            fail_streak, backoff_until = 0, 0.0
        else:
            fail_streak += 1
            if fail_streak >= FAIL_STREAK_LIMIT:
                print(f"\n  \033[31m{fail_streak} publishes failed in a row; "
                      f"stopping rather than retrying forever\033[0m",
                      file=sys.stderr)
                return rc
            wait = LAST_RETRY_AFTER or min(
                FAIL_BACKOFF_BASE * 2 ** (fail_streak - 1), FAIL_BACKOFF_CAP)
            backoff_until = time.time() + wait
            why = ("the server named the wait" if LAST_RETRY_AFTER
                   else f"failure #{fail_streak}")
            print(f"  \033[33mnext attempt held {wait:.0f}s ({why})\033[0m",
                  flush=True)
        # A long-lived -w session keeps republishing from the code it started
        # with, so pressing r after an edit silently reverts the live page to
        # the older layout.  Say so rather than let the page flip back and
        # forth between two versions.
        if born and self_mtime() > born:
            print("\n  \033[33msgpur was edited since this session started; "
                  "press q and rerun to publish the new version\033[0m")
        # Re-read every cycle so `sgpur --set-inbox` in another shell takes
        # effect without restarting this one.
        inbox = read_inbox()
        seen = inbox_get(inbox) if inbox else None
        hint = ("    \033[2m(or press refresh on the web page)\033[0m"
                if inbox else "")
        print(f"\n  \033[2m[r] refresh    [q] quit\033[0m{hint}", flush=True)
        try:
            # Exactly two things ask for a republish: pressing r, and the
            # button on the web page.  Every other byte that arrives on stdin
            # is ignored.
            #
            # The test used to be "any byte that is not a quit key", which is
            # not the same thing and costs one sacct plus one srun per running
            # allocation each time it fires.  On 2026-08-14 that ran unattended
            # for hours: a terminal's anti-idle keep-alive sends a NUL every so
            # often, and a NUL is a byte.  The docstring above says a keypress
            # is a person doing this by hand, and that is only true if the gate
            # tests for the key the banner promises instead of for arrival.
            k = ""
            # When the mailbox is next due.  A deadline and not "whenever
            # read_key happens to time out": an ignored byte also ends the
            # wait, so using the timeout as the cue lets a keep-alive that
            # arrives faster than INBOX_POLL starve the mailbox completely --
            # every read returns a NUL before the timeout, and the web button
            # is never collected.  The deadline still throttles the outbound
            # GET to one per INBOX_POLL no matter how many bytes arrive.
            next_poll = time.time() + INBOX_POLL
            while True:
                # Wake every INBOX_POLL to check the mailbox, but a keypress
                # still returns instantly: select wakes on whichever is first.
                # The check itself touches no filesystem, no Slurm and no
                # subprocess -- it is one outbound GET, ~4 ms of CPU.
                k = read_key(max(0.0, next_poll - time.time()) if inbox
                             else None)
                if k in ("q", "Q", "\x03", "\x04"):
                    break
                if k in ("r", "R"):
                    trigger = f"keypress {k!r}"
                    break
                if k:
                    # Say so and keep waiting.  Swallowing input silently would
                    # make "why is r not working" the next mystery, but a line
                    # per byte would bury the screen under a keep-alive, so it
                    # is said once and then only occasionally.
                    ignored += 1
                    if ignored == 1 or ignored % 50 == 0:
                        why = ("  (a terminal anti-idle keep-alive sends this)"
                               if k == "\x00" else "")
                        n = "" if ignored == 1 else f" x{ignored}"
                        print(f"  \033[2mignored {k!r}{n} -- only r "
                              f"refreshes{why}\033[0m", flush=True)
                # Reached on both an ignored byte and an elapsed timeout: the
                # mailbox is due on a clock, not on whichever of the two ended
                # the wait.  The clock is also what throttles the outbound GET,
                # so a burst of bytes still cannot become a burst of requests.
                # Without an inbox there is nothing to collect and read_key
                # blocks, so k here is always a real byte.
                if not inbox or time.time() < next_poll:
                    continue
                next_poll = time.time() + INBOX_POLL
                cur = inbox_get(inbox)
                if cur is None:              # mailbox unreachable: keep waiting
                    continue
                if seen is None or cur == seen:
                    seen = cur
                    continue
                seen = cur
                # A stuck tab or a double click must not machine-gun sacct
                # and srun.  Publishing already takes ~40 s so this almost
                # never bites; it exists for the case where it would.
                gap = INBOX_MIN_GAP - (time.time() - last_pub)
                if gap > 0:
                    print(f"  \033[2mheld {gap:.0f}s (min gap between "
                          f"web-triggered refreshes)\033[0m", flush=True)
                    time.sleep(gap)
                print("  \033[36mrefresh requested from the web page\033[0m")
                trigger = f"web page (mailbox {cur})"
                k = "r"
                break
        except KeyboardInterrupt:
            k = "q"
        if k in ("q", "Q", "\x03", "\x04", ""):
            print("  bye")
            return rc
        print()


def main() -> None:
    ap = argparse.ArgumentParser(
        prog="sgpur",
        description="Publish the sgpu GPU-time ledger to a surge.sh page.",
        epilog="The page is a snapshot taken now, not a live feed; re-run to refresh.")
    ap.add_argument("window", nargs="?", default="24h",
                    help="look-back window, default 24h (30m / 6h / 3d)")
    ap.add_argument("-j", "--job", action="append", default=[],
                    help="only these jobs (repeatable); window widens to cover them")
    ap.add_argument("-u", "--user", default=os.environ.get("USER", ""),
                    help="whose jobs to show, default yourself")
    ap.add_argument("-d", "--domain", default=DEFAULT_DOMAIN,
                    help=f"surge subdomain, default {DEFAULT_DOMAIN}")
    ap.add_argument("--min-step", type=float, default=60.0,
                    help="steps shorter than this are probes and get filtered, default 60")
    ap.add_argument("--gap", type=float, default=60.0,
                    help="gap above this counts as a break for the same identity, default 60")
    ap.add_argument("-o", "--out", default=None,
                    help="write the html here as well as to the site dir")
    ap.add_argument("-n", "--no-deploy", action="store_true",
                    help="build the page but do not publish it")
    ap.add_argument("--no-live", action="store_true",
                    help="skip the live GPU sample (no srun onto compute nodes)")
    ap.add_argument("-w", "--watch", action="store_true",
                    help="stay open after publishing; press r to republish, q to quit")
    ap.add_argument("-q", "--quiet", action="store_true", help="print the url only")
    ap.add_argument("--setup", action="store_true",
                    help="one-time: write the surge token into ~/.netrc, then exit")
    ap.add_argument("--set-password", action="store_true",
                    help="set the passphrase that encrypts the page, then exit")
    ap.add_argument("--no-encrypt", action="store_true",
                    help="publish in the clear even though a passphrase is set")
    ap.add_argument("--teardown", metavar="DOMAIN",
                    help="delete a published site, then exit")
    ap.add_argument("--set-inbox", metavar="URL",
                    help="point -w at a Cloudflare Worker so the web page's "
                         "refresh button can trigger a republish")
    opts = ap.parse_args()
    if opts.setup:
        sys.exit(setup_credentials())
    if opts.set_password:
        sys.exit(set_password())
    if opts.teardown:
        sys.exit(teardown(opts.teardown))
    if opts.set_inbox:
        sys.exit(cmd_set_inbox(opts.set_inbox))
    opts.span = S.parse_duration(opts.window)

    if opts.watch:
        sys.exit(watch_loop(opts))
    sys.exit(publish_once(opts))


if __name__ == "__main__":
    main()
