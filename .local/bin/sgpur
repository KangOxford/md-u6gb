/* --- search ------------------------------------------------------------
   Sits in the header because a feature with no entry point is not a feature.
   It filters rows in every section at once.  The ruler rows are excluded in
   JS, not here: ruler_html() emits class="row" exactly like the data rows do
   and it IS the shared time axis -- hiding one would leave every chart below
   without an x-axis and nothing on the page would say why. */
.srch{display:flex;align-items:center;gap:8px;margin:10px 0 2px;max-width:660px}
.srch input{flex:1 1 auto;min-width:0;padding:7px 11px;font:13px/1.3 var(--mono);
  color:var(--fg);background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.18);border-radius:6px}
