  <div class="lock">&#128274;</div>
  <h1>GPU time ledger</h1>
  <div class="why">This page is encrypted in your browser.<br>Enter the passphrase to read it.</div>
  <form id="gform" autocomplete="on">
    <input id="pw" type="password" name="password" autocomplete="current-password"
           placeholder="passphrase" autofocus spellcheck="false">
