#!/usr/bin/env python3
"""sgpur -- publish the sgpu GPU-time ledger as a web page on surge.sh.

sgpu draws the ledger into a character grid; this draws the same ledger into
real vector geometry and pushes it to a public URL.  The data layer is not
duplicated: `collect()` and every parsing rule (identity extraction, interval
union, the three cleaning rules) are imported straight out of sgpu, so the two
tools can never disagree about what happened.

Why a separate script rather than a third backend inside sgpu: the ANSI and
curses backends share `Renderer.build() -> [(text, style)]` because both paint
a character grid.  A terminal cell here is ~34 minutes wide.  HTML addresses
time continuously, so it wants a different renderer, not the same one behind a
flag.

There is no daemon.  BriCS forbids resident pollers on login nodes, so the page
is a snapshot: every `sgpur` invocation resamples sacct and overwrites the same
URL.  The page shows its own age in real time and turns amber, then red, as it
goes stale, so a reader can always tell how old the numbers are.
"""

from __future__ import annotations

import argparse
import base64
import concurrent.futures
import gzip
import hashlib
import html
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

# sacct hands back naive datetimes in the server's local zone (UTC on this
# cluster).  The reader is in London, so every displayed time is converted;
# nothing is ever formatted straight off the naive value.
DISPLAY_TZ = ZoneInfo(os.environ.get("SGPUR_TZ", "Europe/London"))


def L(dt: datetime) -> datetime:
    """naive server-local -> aware, in the reader's zone."""
    return dt.astimezone(DISPLAY_TZ)


SGPU_PATH = os.environ.get("SGPU_PATH", "/projects/public/u6gb/.local/bin/sgpu")
DEFAULT_DOMAIN = os.environ.get("SGPUR_DOMAIN", "gpu-ledger-q7x2m4.surge.sh")
SITE_DIR = os.environ.get(
    "SGPUR_SITE",
    os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
                 "sgpur", "site"))
SECRET_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "sgpur", "secret.json")
PBKDF2_ITERS = 600_000          # OWASP 2023 floor for PBKDF2-HMAC-SHA256


def load_sgpu(path: str):
    """Import sgpu, which has no .py suffix, as a module.

    The sys.modules registration is mandatory, not tidiness: @dataclass
    resolves annotations through sys.modules[cls.__module__], and sgpu's
    dataclasses reference each other (Job holds list[Lane]).  Without it the
    import dies on `NoneType has no attribute __dict__`.
    """
    if not os.path.exists(path):
        sys.exit(f"sgpur: cannot find sgpu at {path} (set SGPU_PATH)")
    loader = importlib.machinery.SourceFileLoader("sgpumod", path)
    spec = importlib.util.spec_from_loader("sgpumod", loader)
    mod = importlib.util.module_from_spec(spec)
    sys.modules["sgpumod"] = mod
    loader.exec_module(mod)
    return mod


S = load_sgpu(SGPU_PATH)

# --- presentation ---------------------------------------------------------

# Keys match sgpu's STYLES so the web page and the terminal never disagree
# about what a colour means.  Values are the print-friendly palette from the
# hand-drawn R6 timeline the user asked this to look like.
FILL = {
    "full":    ("#a6d3a6", "#79b479"),   # >= 80% of the allocation computing
    "mid":     ("#f2d98a", "#d9b74e"),   # 35 - 80%
    "low":     ("#eeb98c", "#d99356"),   # < 35%
    "held":    ("#eceef0", "#d3d8dd"),   # allocated, nothing running on it
    "pending": ("#f7f8f9", "#dfe3e7"),   # queued, holds no GPU
}
BAD_COLOR = "#e58f8f"
RUN_COLOR = "#7fb3e8"
# The two live tracks must not share a hue, or the eye reads them as one long
# bar in two pieces.  Green is the page's "computing" colour already (the
# allocations legend), blue its "occupied" one; red replaces the blue when the
# memory is held without being used.
COMPUTE_COLOR, COMPUTE_EDGE = "#a6d3a6", "#79b479"
MEM_COLOR, MEM_EDGE = "#7fb3e8", "#5c93c9"
# Node rows get a warm pair against the cards' cool one.  Same two quantities,
# but one level up the hierarchy: sharing green/blue with the GPU rows made a
# machine's line and a card's line indistinguishable at a glance, which is the
# one thing a grouped list has to get right.
NODE_CPU_COLOR, NODE_CPU_EDGE = "#e8956f", "#c96f4a"
NODE_MEM_COLOR, NODE_MEM_EDGE = "#f2c96a", "#d9a63e"

