JS = """

// Search over everything the page already knows.  The haystack is each row's
// visible text PLUS every data-tip inside it, because the tips are where the
// job ids, node names, exact times and full command lines live -- searching
// only what is painted would miss most of what people come here to find.
//
// The ruler rows are filtered out by hand.  ruler_html() emits class="row"
// exactly like the data rows, and it IS the shared time axis: hide it and
// every chart below loses its x-axis with nothing to say why.
// Nothing can reach the login node -- it has no public entrance.  So the
// button does not command the terminal, it leaves a note in a Cloudflare
// mailbox that the terminal walks out to collect every few seconds.  Both
// halves poll; neither listens.
//
// The button is the only thing on this page that asks the cluster for
// anything.  Cmd+R deliberately is not: reloading means "show me this page
// again", it is how you re-read what is already here, and it also fires for a
// bookmark, a restored tab and the back button.  Hanging one sacct and one
// srun off that gesture makes re-reading cost a cluster sample, which is the
// opposite of what the gesture means.  Reading stays free; only a click spends.
//
// Why it cannot be instant: the snapshot does not exist yet when you press.
// Producing it costs one sacct and one srun, so it happens once per click and
// never on a timer.
function initRefresh(){
  var b=document.getElementById('rbtn');
  if(!b) return;
  var url=b.dataset.url, tok=b.dataset.token, base=BUILD_STAMP, t0=0;
  function set(s,txt){ if(s) b.dataset.s=s; else b.removeAttribute('data-s');
                       b.textContent=txt; }
  // Watch this page's own build stamp: same origin, so no CORS, and it is the
  // one signal that survives the CDN.  A newer stamp means the terminal
  // answered and surge has already served the new bytes.
  function poll(){
    var wait=Math.round((Date.now()-t0)/1000);
    if(wait>300){ set('fail','↻ no answer — is sgpur -w running?'); return; }
    set('wait','waiting for the terminal… '+wait+'s');
    // The build stamp sits in the first 400 bytes, so read 400 bytes rather
    // than the whole 100 KB page -- 258x less over a 90 s wait.  If anything in
    // the path ignores Range the full page comes back and the match still works.
    fetch(location.pathname+'?_='+Date.now(),
          {cache:'no-store',headers:{'Range':'bytes=0-399'}})
      .then(function(r){ return r.text() })
      .then(function(t){
        var m=t.match(/name="build" content="(\\d+)"/);
        if(m && (+m[1])>base){
          set('wait','new snapshot — reloading…');
          setTimeout(function(){ location.reload() },400);
        } else setTimeout(poll,4000);
      })
      .catch(function(){ setTimeout(poll,6000) });
  }
  b.addEventListener('click',function(){
    if(b.dataset.s==='wait') return;
    t0=Date.now(); set('wait','requesting…');
    // The Worker authenticates the same way for browsers and the login node: a
    // private x-token header.  Its OPTIONS route explicitly allows this
    // preflight, so the token never appears in a URL, browser history or
    // intermediary request log.
    fetch(url,{method:'POST',mode:'cors',headers:{'x-token':tok}})
      .then(function(r){
        if(!r.ok) throw new Error('HTTP '+r.status);
        return r.text();
      })
      .then(function(){ poll() })
      .catch(function(){ set('fail','↻ mailbox unreachable') });
  });
}

function initSearch(){
  var box=document.getElementById('q'), out=document.getElementById('qn');
  if(!box) return;
  var rows=[].slice.call(document.querySelectorAll('.row,.hrow,.lrow,details'))
    .filter(function(r){ return !r.querySelector('.track.ruler'); });
  rows.forEach(function(r){
    var t=r.textContent||'';
    if(r.getAttribute('data-tip')) t+=' '+r.getAttribute('data-tip');
    [].slice.call(r.querySelectorAll('[data-tip]')).forEach(function(e){
      t+=' '+e.getAttribute('data-tip');
    });
    r.setAttribute('data-hay',t.toLowerCase().replace(/\\s+/g,' '));
  });
  var secs=[].slice.call(document.querySelectorAll('section'));
  function apply(){
    var q=box.value.toLowerCase().trim();
    var terms=q?q.split(/\\s+/):[];
    var pos=terms.filter(function(t){return t.charAt(0)!=='-'&&t.length;});
    var neg=terms.filter(function(t){return t.charAt(0)==='-'&&t.length>1;})
                 .map(function(t){return t.slice(1);});
    var shown=0;
    rows.forEach(function(r){
      var h=r.getAttribute('data-hay')||'';
      var ok=pos.every(function(t){return h.indexOf(t)>=0;})
          && !neg.some(function(t){return h.indexOf(t)>=0;});
      r.classList.toggle('qhide',!ok);
      if(ok) shown++;
    });
    // Per-section counts: an empty chart with no explanation reads as a bug.
    secs.forEach(function(sec){
      var h2=sec.querySelector('h2'); if(!h2) return;
      var tag=h2.querySelector('.qn');
      if(!q){ if(tag) tag.remove(); return; }
      var n=0;
      rows.forEach(function(r){ if(sec.contains(r)&&!r.classList.contains('qhide')) n++; });
      if(!tag){ tag=document.createElement('span'); tag.className='qn';
                h2.appendChild(tag); }
      tag.textContent=n+' match'+(n===1?'':'es');
      tag.className='qn'+(n?'':' zero');
    });
    out.textContent = q ? (shown+' row'+(shown===1?'':'s')) : '';
  }
  box.addEventListener('input',apply);
  box.addEventListener('keydown',function(e){
    if(e.key==='Escape'){ box.value=''; apply(); box.blur(); }
  });
  document.addEventListener('keydown',function(e){
    if(e.key==='/'&&document.activeElement!==box){ e.preventDefault(); box.focus(); }
  });
}

(function(){
  var tip=document.getElementById('tip');
  document.addEventListener('mouseover',function(e){
    var t=e.target.closest('[data-tip]'); if(!t) return;
    tip.textContent=t.getAttribute('data-tip'); tip.style.display='block';
  });
  document.addEventListener('mousemove',function(e){
    if(tip.style.display!=='block') return;
    var w=tip.offsetWidth,h=tip.offsetHeight;
    var x=e.clientX+14, y=e.clientY+16;
    if(x+w>innerWidth-8) x=e.clientX-w-14;
    if(y+h>innerHeight-8) y=e.clientY-h-16;
    tip.style.left=Math.max(8,x)+'px'; tip.style.top=Math.max(8,y)+'px';
  });
  document.addEventListener('mouseout',function(e){
    if(e.target.closest('[data-tip]')) tip.style.display='none';
  });

  // The page is a snapshot, not a feed.  Show its age so nobody reads stale
  // numbers as live ones.
  initSearch();
  initRefresh();
  var born=SNAPSHOT_EPOCH, el=document.getElementById('age');
  function fmt(s){
    if(s<60) return Math.max(0,Math.round(s))+'s ago';
    if(s<3600) return Math.round(s/60)+' min ago';
    if(s<86400) return (s/3600).toFixed(1)+' h ago';
    return (s/86400).toFixed(1)+' d ago';
  }
  function tick(){
    var s=Date.now()/1000-born;
    el.textContent=fmt(s);
    // "how old is this" and "am I fetching a newer one" are the same question
    // asked twice, so they share one element instead of growing a widget.
    var n=el.dataset.note;
    if(n){ var sp=document.createElement('span');
           sp.className='note'; sp.textContent=' \u00b7 '+n; el.appendChild(sp); }
    el.className = s<900?'fresh' : s<7200?'warm' : 'stale';
    el.title = s<900?'fresh' : 'run sgpur again to refresh';
  }
  tick(); setInterval(tick,1000); window.sgpurAgeTick=tick;
})();
"""


def esc(text) -> str:
    return html.escape(str(text), quote=True)


def att(text) -> str:
    """Escape for an attribute value, newlines included.

    html.escape leaves \\n alone.  HTML5 does preserve literal newlines inside
    attribute values, so it renders correctly today, but any minifier or CDN
    rewrite is free to collapse them and the multi-line tooltips would silently
    become one long line.  &#10; says what is meant.
    """
    return html.escape(str(text), quote=True).replace("\n", "&#10;")


def pct(t: datetime, t0: datetime, t1: datetime) -> float:
    span = (t1 - t0).total_seconds() or 1.0
    return max(0.0, min(100.0, (t - t0).total_seconds() / span * 100.0))


def gh(seconds: float, gpus: float) -> float:
    return seconds * gpus / 3600.0


def tick_step(span_s: float) -> float:
    """Pick a grid interval that leaves labels ~90px apart on a wide screen."""
    for cand in (300, 600, 900, 1800, 3600, 7200, 10800, 21600, 43200, 86400,
                 172800, 604800):
        if span_s / cand <= 16:
            return cand
    return 604800


def grid_html(t0: datetime, t1: datetime, step: float, now: datetime) -> str:
    """Vertical rules, reused verbatim inside every track so rows line up.

    Ticks are anchored to wall-clock boundaries rather than to the window
    start: a line at 18:00 is readable, a line at 17:43 is noise.
    """
    out = []
    for t in tick_times(t0, t1, step):
        lt = L(t)
        cls = "gl day" if lt.hour == 0 and lt.minute == 0 else "gl"
        out.append(f'<i class="{cls}" style="left:{pct(t, t0, t1):.4f}%"></i>')
    if t0 <= now <= t1:
        out.append(f'<i class="now" style="left:{pct(now, t0, t1):.4f}%"></i>')
    return "".join(out)


def tick_times(t0: datetime, t1: datetime, step: float) -> list[datetime]:
    """Grid lines land on wall-clock boundaries IN THE READER'S ZONE.

    Anchoring on the unix epoch only lines up for zones offset by a whole
    number of hours; anchoring on local midnight is correct for any zone.
    Returned values stay server-naive so they compare against t0/t1.
    """
    midnight_local = L(t0).replace(hour=0, minute=0, second=0, microsecond=0)
    base = midnight_local.astimezone().replace(tzinfo=None)
    out, k = [], int((t0 - base).total_seconds() // step)
    while True:
        t = base + timedelta(seconds=k * step)
        k += 1
        if t > t1:
            break
        if t >= t0:
            out.append(t)
    return out


def ruler_html(t0, t1, fc_t1, step: float, lw: int) -> str:
    def label(t):
        lt = L(t)
        midnight = lt.hour == 0 and lt.minute == 0
        return ("tk day" if midnight else "tk",
                lt.strftime("%m-%d") if midnight else lt.strftime("%H:%M"))

    past = "".join(f'<span class="{c}" style="left:{pct(t, t0, t1):.4f}%">{s}</span>'
                   for t, (c, s) in ((t, label(t)) for t in tick_times(t0, t1, step)))
    # Ticks beyond now live in the forecast layer, measured against the full
    # window, so they appear only when the toggle expands the axis.
    fut = "".join(f'<span class="{c} fut" style="left:{pct(t, t0, fc_t1):.4f}%">{s}</span>'
                  for t, (c, s) in ((t, label(t)) for t in tick_times(t1, fc_t1, step)))
    # An invisible tail spacer keeps this track exactly as wide as the data
    # rows above it.  Without it the ruler is wider and every tick sits to the
    # right of the bar it is supposed to mark.
    return (f'<div class="row"><div class="lbl" style="--lw:{lw}px"></div>'
            f'<div class="track ruler"><div class="axis"></div>'
            f'<div class="tinner">{past}</div>'
            f'<div class="fclayer">{fut}</div></div>'
            f'<div class="tail spacer"></div></div>')


def seg_tip(seg, job) -> str:
    """Everything the terminal has to truncate goes in the hover text."""
    lines = []
    if seg.kind == "busy":
        head = seg.ident or "(unidentified)"
        if seg.run_seq:
            head += f"   run #{seg.run_seq}"
        lines.append(head)
        lines.append(f"{seg.gpus:g} of {seg.alloc_gpus:g} GPU  ·  {S.fmt_dur(seg.secs)}"
                     f"  ·  {gh(seg.secs, seg.gpus):.1f} GPU-h computed")
    elif seg.kind == "pending":
        lines.append("queued, holds no GPU")
        lines.append(S.fmt_dur(seg.secs))
    else:
        lines.append("allocation held, no qualifying step")
        lines.append(f"{seg.alloc_gpus:g} GPU idle  ·  {S.fmt_dur(seg.secs)}"
                     f"  ·  {gh(seg.secs, seg.alloc_gpus):.1f} GPU-h burned")
    lines.append(f"{L(seg.start):%m-%d %H:%M:%S} → {L(seg.end):%m-%d %H:%M:%S} "
                 f"{L(seg.end):%Z}")
    if seg.end_state:
        lines.append("ends " + STATE_LABEL.get(seg.end_state[:9], seg.end_state))
    lines.append(f"job {job.jid}  {job.nodes}N {job.gpus:g}G  {job.name}")
    if job.nodelist:
        lines.append(job.nodelist)
    cmds, seen = [], set()
    for st in seg.steps:
        c = (st.cmd or "").strip()
        if c and c not in seen:
            seen.add(c)
            cmds.append(f"  {st.sid}  {c}")
    if cmds:
        lines.append("")
        lines.append(f"{len(seg.steps)} step(s):")
        lines += cmds[:6]
        if len(cmds) > 6:
            lines.append(f"  ... {len(cmds) - 6} more")
    return "\n".join(lines)


def seg_div(seg, job, t0, t1) -> str:
    left = pct(seg.start, t0, t1)
    right = pct(seg.end, t0, t1)
    width = max(right - left, 0.12)
    if seg.kind == "busy":
        key = S.util_key(seg.gpus / seg.alloc_gpus if seg.alloc_gpus else 0.0)
        text = seg.ident or "(unidentified)"
    elif seg.kind == "pending":
        key, text = "pending", "queued"
    else:
        key, text = "held", ""
    bg, bd = FILL[key]
    bad = " bad" if seg.end_state in S.BAD_STATES else ""
    cls = f"seg {key}{bad}" + (" pending" if key == "pending" else "")
    label = f"<span>{esc(text)}</span>" if text and width > 3 else ""
    return (f'<div class="{cls}" style="left:{left:.4f}%;width:{width:.4f}%;'
            f'background:{bg};border-color:{bd}" data-tip="{att(seg_tip(seg, job))}">'
            f'{label}</div>')


def forecast_layer(job, t0, t1, fc_t1, limit_s, now) -> str:
    """The scheduled remainder, positioned against the FULL forecast window.

    Lives in its own layer rather than inside .tinner: .tinner is the past,
    and gets squeezed to 2/3 when the forecast opens, whereas this layer is
    always sized against t0 -> fc_t1.  Hidden until the toggle is on, so the
    default view stays purely measured.
    """
    if not limit_s or not job.start:
        return ""
    end = job.start + timedelta(seconds=limit_s)
    if end <= now:
        return ""
    left = pct(now, t0, fc_t1)
    right = pct(end, t0, fc_t1)
    remain = (end - now).total_seconds()
    tip = (f"{job.jid}  scheduled to end {L(end):%m-%d %H:%M} {L(end):%Z}\n"
           f"{S.fmt_dur(remain)} of wall clock left of a "
           f"{S.fmt_dur(limit_s)} limit\n"
           f"upper bound: the job can still finish or fail earlier")
    return (f'<div class="fcseg" style="left:{left:.4f}%;'
            f'width:{max(right - left, 0.1):.4f}%" data-tip="{att(tip)}">'
            f'<span>{S.fmt_dur(remain)} left</span></div>'
            f'<i class="fcend" style="left:{right:.4f}%"></i>')


def overview_section(snap, t0, t1, fc_t1, step, lw, deadlines) -> str:
    grid = grid_html(t0, t1, step, snap.now)
    rows = []
    for j in snap.live:
        segs = "".join(seg_div(s, j, t0, t1) for s in j.segments)
        end = j.end or (snap.now if j.base_state == "RUNNING" else None)
        mark = ""
        if end is not None:
            lab = STATE_LABEL.get(j.base_state[:9], j.base_state.lower())
            if j.base_state == "RUNNING":
                lab = "→ running"
            cls = "mark bad" if j.base_state in S.BAD_STATES else "mark"
            x = pct(end, t0, t1)
            if x > 82:
                cls += " flip"
            mark = (f'<span class="{cls}" style="left:{x:.4f}%">{esc(lab)}</span>')
        alloc = sum(gh(s.secs, s.alloc_gpus) for s in j.segments if s.kind != "pending")
        busy = sum(gh(s.secs, s.gpus) for s in j.segments if s.kind == "busy")
        ratio = busy / alloc * 100 if alloc else 0.0
        tail = (f'<div class="tail"><span class="g">{ratio:.0f}%</span>'
                f'<span>of {alloc:,.0f} GPU-h</span></div>')
        rows.append(
            f'<div class="row"><div class="lbl" style="--lw:{lw}px">'
            f'<span class="jid">{esc(j.jid)}</span>'
            f'<span class="meta">{j.nodes}N&nbsp;{j.gpus:g}G</span>'
            f'<span class="nm">{esc(j.name)}</span></div>'
            f'<div class="track"><div class="tinner">{grid}{segs}{mark}</div>'
            f'<div class="fclayer">'
            f'{forecast_layer(j, t0, t1, fc_t1, deadlines.get(j.jid), snap.now)}'
            f'</div></div>{tail}</div>')
    return "".join(rows)


SESSION_DIR = os.environ.get(
    "SGPUR_SESSION_DIR",
    "/projects/public/u6gb/.claude/projects/-lus-lfs1aip2-projects-public-u6gb")
SESS_CFG = os.path.expanduser("~/.config/sgpur/session_names.json")


def session_map(idents) -> dict:
    """ident -> (short session name, hover text): which Claude session drives
    which experiment.

    Resolved by who wrote the identity string FIRST.  Mere mentions cannot
    tell driver from spectator -- every session that ever ran gtop contains
    every job id -- but the driving session composes the srun command line
    before the step exists, so the earliest timestamped occurrence wins; a
    same-second tie goes to the larger log, the main-session rule.  Verified
    on real data: dfm-rung* resolves to the dfm session, v5m3-dump* to
    mid-train, ctx2k-hybpm-train to the hybrid session.

    The name is the session's own title (its first segment: one word), a
    hand-given override, or the id prefix.  Resolutions are cached in
    SESS_CFG, so a resolved identity costs nothing; each batch of new ones
    costs one sequential sweep of the recently-active session logs.
    """
    try:
        with open(SESS_CFG) as fh:
            cfg = json.load(fh)
    except Exception:
        cfg = {}
    ids = cfg.setdefault("idents", {})       # ident -> session id ("" = no hit)
    pref = cfg.setdefault("prefixes", {})    # fallback key -> sid ("" = miss)
    titles = cfg.setdefault("titles", {})    # session id -> full title
    over = cfg.setdefault("overrides", {})   # session id -> hand-given name
    # Sessions that must never be credited: the sgpur development sessions.
    # Their logs quote experiment names out of screenshots and grep output,
    # and a quotation can predate the driver's own log inside the scan
    # window.  Cached verdicts pointing at them are purged so those idents
    # resolve afresh; stale too-short keys are purged the same way.
    ign = set(cfg.get("ignore") or [])
    for k in [k for k, v in ids.items() if v in ign]:
        del ids[k]
    for k in [k for k, v in pref.items()
              if v in ign or len(k.rstrip("-")) < 6]:
        del pref[k]

    def resolve(ident):
        """Exact hit first, then the longest resolved fallback prefix."""
        sid = ids.get(ident) or ""
        via = ""
        if not sid:
            for c in _sess_cands(ident):
                if pref.get(c):
                    sid, via = pref[c], c
                    break
        return sid, via

    # Rescan only what neither layer can answer and only where an untried
    # fallback key remains -- a full miss with every key cached stays a miss
    # until the cache is deleted, instead of costing a sweep per refresh.
    todo = set()
    for i in idents:
        if resolve(i)[0]:
            continue
        if i not in ids or any(c not in pref for c in _sess_cands(i)):
            todo.add(i)
    if todo and os.path.isdir(SESSION_DIR):
        now = time.time()
        try:
            files = [(e.path, e.stat().st_size) for e in os.scandir(SESSION_DIR)
                     if e.name.endswith(".jsonl") and e.is_file()
                     and e.name[:-6] not in ign
                     and now - e.stat().st_mtime < 14 * 86400]
        except OSError:
            files = []
        ts_re = re.compile(rb'"timestamp":"([^"]+)"')
        # Search for every fallback key of every unresolved identity at once:
        # a fleet name like dfm-rung54000-3 never appears verbatim anywhere,
        # but the template it was formatted from carries "dfm-rung" literally.
        keys = {c for i in todo for c in _sess_cands(i)} | set(todo)
        best = {}                            # key -> (ts, -size, sid, title)
        for path, size in files:
            want = {k.encode() for k in keys}
            try:
                with open(path, "rb") as f:
                    sid, title = os.path.basename(path)[:-6], ""
                    try:
                        h = json.loads(f.readline())
                        sid = h.get("sessionId") or sid
                        title = h.get("aiTitle") or ""
                    except Exception:
                        pass
                    for line in f:
                        if not want:
                            break
                        for t in list(want):
                            if t in line:
                                m = ts_re.search(line)
                                cand = ((m.group(1).decode() if m else "9999"),
                                        -size, sid, title)
                                tt = t.decode()
                                if tt not in best or cand < best[tt]:
                                    best[tt] = cand
                                want.discard(t)
            except OSError:
                continue
        for k in keys:
            if k in best:
                _ts, _ns, sid, title = best[k]
                pref[k] = sid
                titles.setdefault(sid, title)
            else:
                pref.setdefault(k, "")   # cached miss: no sweep per refresh
        for tt in todo:
            ids[tt] = best[tt][2] if tt in best else ids.get(tt, "")
        try:
            os.makedirs(os.path.dirname(SESS_CFG), exist_ok=True)
            tmp = SESS_CFG + ".tmp"
            with open(tmp, "w") as fh:
                json.dump(cfg, fh, ensure_ascii=False, indent=1)
            os.replace(tmp, SESS_CFG)
        except OSError:
            pass
    out = {}
    for i in idents:
        sid, via = resolve(i)
        if not sid:
            continue
        title = titles.get(sid, "")
        name = over.get(sid) or (title.split("⑂")[0].strip() if title
                                 else sid[:8])
        tip = (f"driving session: {title or '(untitled)'}\n{sid}\n"
               f"claude --resume {sid}"
               + (f'\nmatched by prefix "{via}"' if via else ""))
        out[i] = (name[:16], tip)
    return out


def _sess_cands(ident: str) -> list:
    """Fallback keys for an identity, most specific first: dash-prefixes with
    trailing digit runs peeled, so dfm-rung54000-3 yields dfm-rung54000,
    dfm-rung and dfm, and e2d-ns-v3-s1 yields e2d-ns-v3, e2d-ns-v, e2d-ns
    and e2d.  Keys shorter than 3 characters match too much and are dropped."""
    out, seen = [], set()
    parts = ident.split("-")
    for k in range(len(parts), 0, -1):
        p = "-".join(parts[:k])
        # Variant tails are digits or trailing capitals: dfm-rung54000 and
        # dfm-tritonOFF both peel back to the template the driver wrote.
        for q in (p, p.rstrip("0123456789"),
                  p.rstrip("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ")):
            # Under 6 characters a key stops discriminating: "dfm" or "v5m"
            # appears in any session that ever discussed the work at all.
            if len(q.rstrip("-")) >= 6 and q not in seen:
                seen.add(q)
                out.append(q)
    return out[1:]     # [0] is the full name itself, handled by the exact layer


def lanes_section(snap, t0, t1, step, lw, sess=None) -> str:
    """One row per experiment identity, across jobs.  The holes are the breaks."""
    grid = grid_html(t0, t1, step, snap.now)
    # Rows that ran within the fold window stay in sight; the rest collapse
    # behind one line.  The criterion is time, not a row count, so how many
    # fold moves with the data.  The sort is already most-recent-first, so
    # each bucket keeps its order.
    QUIET_S = 12 * 3600
    act, quiet = [], []
    n_quiet = 0
    split_seen = {False: False, True: False}
    for h in snap.hist:
        # Same device as the restart-history section below: the non-experiment
        # buckets already sort last, so mark the boundary and desaturate them.
        # Only the caption differs, because the axes differ -- this chart is
        # wall clock, that one is cumulative running time.
        other = h.ident in S.NON_EXPERIMENT
        la = last_active(h)
        is_quiet = la is None or (snap.now - la).total_seconds() > QUIET_S
        rows = quiet if is_quiet else act
        if is_quiet:
            n_quiet += 1
        if other and not split_seen[is_quiet]:
            split_seen[is_quiet] = True
            rows.append('<div class="hsplit">not experiments &mdash; a shell '
                        'someone attached, or a command line Slurm did not '
                        'record. Same clock as the rows above, because they '
                        'hold GPUs all the same.</div>')
        bars = []
        for r in h.runs:
            left = pct(r.start, t0, t1)
            width = max(pct(r.end, t0, t1) - left, 0.12)
            bad = r.end_state in S.BAD_STATES
            fill = RUN_COLOR if not bad else BAD_COLOR
            edge = "#5c93c9" if not bad else "#c97a7a"
            if other:
                fill = "#c6ccd3" if not bad else "#dcb4b4"
                edge = "#aab1b9" if not bad else "#c39d9d"
            tip = (f"{h.ident}   run #{r.seq} of {len(h.runs)}\n"
                   f"{r.gpus:g} GPU  ·  {S.fmt_dur(r.secs)}  ·  "
                   f"{gh(r.secs, r.gpus):.1f} GPU-h\n"
                   f"{L(r.start):%m-%d %H:%M:%S} → {L(r.end):%m-%d %H:%M:%S} "
                   f"{L(r.end):%Z}\n"
                   f"ends {STATE_LABEL.get(r.end_state[:9], r.end_state or '?')}")
            bars.append(
                f'<div class="seg{" bad" if bad else ""}" '
                f'style="left:{left:.4f}%;width:{width:.4f}%;'
                f'background:{fill};border-color:{edge}" '
                f'data-tip="{att(tip)}"></div>')
        bits = [f'<span class="g">{len(h.runs)}</span> runs']
        if h.breaks:
            bits.append(f'brk <span class="g">{h.breaks}</span>')
        if h.bad:
            bits.append(f'<span class="b">✗{h.bad}</span>')
        jids = " ".join(sorted(h.jobs))
        ltip = (f"{h.ident}\n{len(h.runs)} runs · {h.breaks} breaks · {h.bad} bad exits\n"
                f"{S.fmt_dur(h.secs)} busy · {h.gpu_hours:.1f} GPU-h\n"
                f"jobs: {jids}")
        sn = (sess or {}).get(h.ident)
        stag = (f'<span class="sess" data-tip="{att(sn[1])}">{esc(sn[0])}</span>'
                if sn else "")
        rows.append(
            f'<div class="row lane{" other" if other else ""}">'
            f'<div class="lbl" style="--lw:{lw}px">'
            f'<span class="nm" data-tip="{att(ltip)}">{live_dot(h, snap.now)}'
            f'{esc(h.ident)}</span>{stag}</div>'
            f'<div class="track"><div class="tinner">{grid}{"".join(bars)}</div></div>'
            f'<div class="tail"><span>{" · ".join(bits)}</span>'
            f'<span>{h.gpu_hours:,.0f} GPU-h</span></div></div>')
    if quiet:
        act.append(
            f'<details class="lanesfold"><summary><span class="arr">▸</span>'
            f'{n_quiet} quiet identities &mdash; nothing ran in the last 12h, '
            f'click to open</summary>{"".join(quiet)}</details>')
    return "".join(act)


def fmt_span(seconds: float) -> str:
    """Duration for an axis tick: 0 / 2h / 6h30 -- shorter than fmt_dur."""
    total = int(round(seconds / 60))
    h, m = divmod(total, 60)
    if not h:
        return f"{m}m" if m else "0"
    return f"{h}h" if not m else f"{h}h{m:02d}"


def history_chart(snap, t0, t1, step, opts_window) -> str:
    """Restart history as a strip chart rather than a wall of numbers.

    Three visual channels, each carrying exactly one variable so nothing is
    encoded twice:

      run strip    : SAME SCALE AS THE GANTT SECTIONS ABOVE.  The grey track
                     spans the whole look-back window, so one pixel here is
                     the same number of seconds as one pixel up there, and a
                     two-hour block in this section is exactly as wide as a
                     two-hour segment in the allocations chart.  Colour is
                     time actually running, grey is the rest of the window.
                     The axis measures CUMULATIVE running time rather than
                     wall clock, which is what keeps this from being a redraw
                     of the lanes section: that one answers "when", this one
                     answers "how much of the window, in how many pieces".
      GPU-h bar    : absolute card time.  Not implied by the strip -- an
                     identity on 16 GPUs burns four times what the same hours
                     on 4 GPUs do.

    The old `breaks` column is gone: it is always runs-1, so it repeated the
    run count in different words.  `jobs` and `first → last` moved into the
    row's hover text, which is where facts you look up rather than scan belong.
    """
    if not snap.hist:
        return ""
    window_s = (t1 - t0).total_seconds() or 1.0
    max_gh = max((h.gpu_hours for h in snap.hist), default=1.0) or 1.0
    # Same grid pitch as the gantt sections, anchored at 0 instead of at a
    # wall-clock boundary: the lines will not coincide with the ones above
    # (they cannot, one axis is a duration and the other an instant) but the
    # cells are the same size, so lengths read across sections.
    gw = step / window_s * 100

    # `runs` lives on the right, not between the label and the strip: a column
    # there pushed every strip 52px past the tracks in the sections above, so
    # the shared time scale did not actually line up on screen.
    out = [f'<div class="hhead"><div class="hid">identity</div>'
           f'<div class="hseq-h">time running &nbsp;<span class="hint">'
           f'same scale as the charts above: full width = the {esc(opts_window)} '
           f'window &nbsp;·&nbsp; grey = not running &nbsp;·&nbsp; '
           f'red = ended badly</span></div>'
           f'<div class="hstats"><div class="hnum-h">runs</div>'
           f'<div class="hnum-h">busy</div>'
           f'<div class="hnum-h">GPU-h</div></div></div>']

    split_done = False
    for h in snap.hist:
        # sgpu already sorts the two non-experiment buckets to the bottom.  Mark
        # the boundary: they share the bars' scale with real experiments and are
        # usually the largest rows on it, which is worth seeing but needs saying.
        other = h.ident in S.NON_EXPERIMENT
        if other and not split_done:
            split_done = True
            out.append('<div class="hsplit">not experiments &mdash; a shell '
                       'someone attached, or a command line Slurm did not '
                       'record. They set the scale for the bars above.</div>')
        runs = h.runs
        # An identity attached to two allocations at once can accumulate more
        # running time than the window is long.  Clip and say so rather than
        # let one row silently break the shared scale.
        over = h.secs > window_s
        cells = []
        for r in runs:
            bad = r.end_state in S.BAD_STATES
            tip = (f"{h.ident}   run #{r.seq} of {len(runs)}\n"
                   f"{S.fmt_dur(r.secs)}  ·  {r.gpus:g} GPU  ·  "
                   f"{gh(r.secs, r.gpus):.1f} GPU-h\n"
                   f"{L(r.start):%m-%d %H:%M:%S} → {L(r.end):%m-%d %H:%M:%S} "
                   f"{L(r.end):%Z}\n"
                   f"ends {STATE_LABEL.get(r.end_state[:9], r.end_state or '?')}")
            cells.append(f'<i class="{"rc bad" if bad else "rc"}" '
                         f'style="flex:{max(r.secs, 1):.0f} 1 0" '
                         f'data-tip="{att(tip)}"></i>')

        cnt = f'<span class="g">{len(runs)}</span>'
        if h.bad:
            cnt += f'<span class="b">✗{h.bad}</span>'
        span = (f"{L(runs[0].start):%m-%d %H:%M} → {L(runs[-1].end):%m-%d %H:%M} "
                f"{L(runs[-1].end):%Z}" if runs else "")
        idtip = (f"{h.ident}\n{len(runs)} runs across {len(h.jobs)} allocation(s): "
                 f"{' '.join(sorted(h.jobs))}\n{span}\n"
                 f"{S.fmt_dur(h.secs)} busy  ·  {h.gpu_hours:.1f} GPU-h"
                 + (f"\n{h.bad} ended abnormally" if h.bad else "")
                 + ("\nruns overlapped across allocations: total exceeds the "
                    "window, strip clipped at 100%" if over else ""))
        out.append(
            f'<div class="hrow{" other" if other else ""}">'
            f'<div class="hid" data-tip="{att(idtip)}">{live_dot(h, snap.now)}'
            f'{esc(h.ident)}</div>'
            f'<div class="hseq" style="--gw:{gw:.4f}%">'
            f'<div class="hrun{" over" if over else ""}" '
            f'style="width:{min(h.secs / window_s * 100, 100):.3f}%" '
            f'data-tip="{att(idtip)}">{"".join(cells)}</div></div>'
            f'<div class="hstats">'
            f'<div class="hnum plain">{cnt}</div>'
            f'<div class="hnum plain"><b>{S.fmt_dur(h.secs)}</b></div>'
            f'<div class="hnum"><i style="width:{h.gpu_hours / max_gh * 100:.1f}%"></i>'
            f'<b>{h.gpu_hours:,.0f}</b></div></div></div>')

    # Axis: ticks every `step` seconds, the same pitch the gantt ruler uses.
    k, marks = 0, []
    while k * step <= window_s + 1:
        marks.append(f'<span style="left:{k * step / window_s * 100:.4f}%">'
                     f'{fmt_span(k * step)}</span>')
        k += 1
    ticks = "".join(marks)
    out.append(f'<div class="hrow"><div class="hid"></div>'
               f'<div class="hseq-axis">{ticks}</div>'
               f'<div class="hstats"></div></div>')
    return "".join(out)


def segments_detail(snap) -> str:
    """Exact times and full command lines -- the part a terminal must truncate."""
    out = []
    for j in snap.live:
        lines = []
        for sg in j.segments:
            tag = (sg.ident or "(unidentified)") if sg.kind == "busy" else sg.kind
            state = f"  ends {STATE_LABEL.get(sg.end_state[:9], sg.end_state)}" if sg.end_state else ""
            lines.append(f"{L(sg.start):%m-%d %H:%M:%S} → {L(sg.end):%m-%d %H:%M:%S}  "
                         f"{S.fmt_dur(sg.secs):>8}  {sg.gpus:>4.0f}/{sg.alloc_gpus:<4.0f}GPU  "
                         f"{tag}{state}")
            seen = set()
            for st in sg.steps:
                c = (st.cmd or "").strip()
                if c and c not in seen:
                    seen.add(c)
                    lines.append(f"      {st.sid}  {c}")
        out.append(f"<details><summary>{esc(j.jid)} &nbsp; {esc(j.name)} &nbsp; "
                   f"{j.nodes}N {j.gpus:g}G &nbsp; {len(j.segments)} segments</summary>"
                   f"<pre>{esc(chr(10).join(lines))}</pre></details>")
    return "".join(out)


# Two colours, no ramp.  The bar's length already states how long the wait is,
# to the minute; shading it as well spent a whole colour channel restating one
# number and introduced greys and blues that meant nothing else on the page.
QUEUE_COLOR, QUEUE_EDGE = "#f2d98a", "#d9b74e"


def hex_rgba(hexcol: str, alpha: float) -> str:
    h = hexcol.lstrip("#")
    return (f"rgba({int(h[0:2], 16)},{int(h[2:4], 16)},{int(h[4:6], 16)},"
            f"{alpha})")

EWMA_ALPHA = 0.3

# Allocation-renewal jobs queue in order to hold nodes, not to compute.  They
# are a different kind of thing from an experiment waiting for its turn, and
# mixing them into the same amber ramp makes the queue look more contended
# than it is, so they get the page's "computing" green instead.
CHAIN_RE = re.compile(r"(?:^|[-_])chain(?:[-_]|\d|$)", re.I)


def is_chain_job(name: str) -> bool:
    return bool(CHAIN_RE.search(name or ""))


def queue_history(user: str, days: int = 7) -> list:
    """Past queue waits: Start - Submit for jobs that actually started.

    -X keeps this to job records; step records have no queue time and would
    multiply the output by fifty.
    """
    since = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%dT%H:%M")
    try:
        p = subprocess.run(["sacct", "-X", "-P", "-n", "-u", user, "-S", since,
                            "--format=JobID,Submit,Start,AllocNodes"],
                           capture_output=True, text=True, timeout=90)
    except (OSError, subprocess.TimeoutExpired):
        return []
    out = []
    for ln in p.stdout.splitlines():
        f = ln.split("|")
        if len(f) < 4:
            continue
        sub, st = S.parse_time(f[1]), S.parse_time(f[2])
        if not sub or not st:
            continue
        w = (st - sub).total_seconds()
        if 0 <= w < 7 * 86400:
            try:
                nodes = int(f[3] or 0)
            except ValueError:
                nodes = 0
            out.append((st, w, nodes))
    out.sort(key=lambda x: x[0])          # oldest first, EWMA needs the order
    return out


def wait_estimators(hist: list) -> dict:
    """Four ways of saying "how long will the next one wait", side by side.

    They disagree, often by a lot, and which one is right depends on whether
    the queue is in a regime change or not.  Showing all four and naming the
    one that drives the shading is more honest than picking one silently:
    a reader can see at a glance whether the estimate is robust (they cluster)
    or a guess (they do not).
    """
    ws = [w for _t, w, _n in hist]
    if not ws:
        return {}
    n = len(ws)
    k = min(10, n)
    e = ws[0]
    for w in ws[1:]:
        e = EWMA_ALPHA * w + (1 - EWMA_ALPHA) * e
    return {"ewma": e, "mean": sum(ws) / n, "ma": sum(ws[-k:]) / k,
            "last": ws[-1], "n": n, "k": k}


def pending_block(snap, t0, t1, fc_t1, step, lw, user, fc_label) -> str:
    """Queued jobs as bars on the same wall-clock axis as everything above.

    A column of "8h57m" strings does not show that half the queue has been
    sitting there since before the window opened, or that four of them were
    submitted in the same minute.  On the shared axis both are one glance.
    """
    if not snap.pending:
        return ""
    grid = grid_html(t0, t1, step, snap.now)
    est = wait_estimators(queue_history(user))
    pred = est.get("ewma")
    rows = []
    for j in sorted(snap.pending, key=lambda x: x.submit or snap.now):
        if not j.submit:
            continue
        wait = (snap.now - j.submit).total_seconds()
        chain = is_chain_job(j.name)
        bg, bd = ((COMPUTE_COLOR, COMPUTE_EDGE) if chain
                  else (QUEUE_COLOR, QUEUE_EDGE))
        clipped = j.submit < t0
        left = pct(max(j.submit, t0), t0, t1)
        right = pct(snap.now, t0, t1)
        tip = (f"{j.jid}  {j.name}\n{j.nodes} node(s) requested\n"
               f"submitted {L(j.submit):%m-%d %H:%M:%S} {L(j.submit):%Z}\n"
               f"waiting {S.fmt_dur(wait)}, holding no GPU"
               + ("\nallocation renewal: queues to hold nodes, not to compute"
                  if chain else "")
               + ("\nsubmitted before this window opened" if clipped else ""))

        # The shaded remainder has to live in the forecast layer, not beside
        # the solid bar: `now` is the right edge of the window, so anything
        # drawn past it in .tinner clips to zero width.  That is also the
        # honest place for it, since it is the same button that opens every
        # other piece of "what happens next" on this page.
        shade = ""
        if pred:
            eta = j.submit + timedelta(seconds=pred)
            if eta > snap.now:
                l2 = pct(snap.now, t0, fc_t1)
                r2 = pct(eta, t0, fc_t1)
                over = eta > fc_t1
                # The hatch takes the bar's own hue: a green renewal must not
                # sprout an amber forecast, or the two colours stop meaning
                # "what kind of wait this is".
                hatch = (f'repeating-linear-gradient(135deg, transparent 0 4px,'
                         f'{hex_rgba(bg, 0.6)} 4px 8px)')
                shade = (f'<div class="seg pred{" open" if over else ""}" '
                         f'style="left:{l2:.4f}%;width:{max(r2 - l2, 0.15):.4f}%;'
                         f'background:{hatch};border-color:{bd}" '
                         f'data-tip="{att(tip)}&#10;&#10;EWMA estimate: starts around '
                         f'{L(eta):%m-%d %H:%M} {L(eta):%Z}'
                         f'&#10;{S.fmt_dur(pred - wait)} still to go'
                         + ("&#10;beyond the forecast window" if over else "")
                         + f'"><span>{esc(S.fmt_dur(pred - wait))}</span></div>')
            else:
                tip += (f"\n\npast the EWMA estimate by "
                        f"{S.fmt_dur(wait - pred)} -- the queue is slower than "
                        f"the last {est['n']} jobs suggested")

        rows.append(
            f'<div class="row"><div class="lbl" style="--lw:{lw}px">'
            f'<span class="jid">{esc(j.jid)}</span>'
            f'<span class="meta">{j.nodes}N</span>'
            f'<span class="nm">{esc(j.name)}</span></div>'
            f'<div class="track"><div class="tinner">{grid}'
            f'<div class="seg pend{" clip" if clipped else ""}" '
            f'style="left:{left:.4f}%;width:{max(right - left, 0.15):.4f}%;'
            f'background:{bg};border-color:{bd}" data-tip="{att(tip)}"></div>'
            f'</div><div class="fclayer">{shade}</div></div>'
            f'<div class="tail"><span>waiting</span>'
            f'<span class="g">{S.fmt_dur(wait)}</span></div></div>')

    # Second row: the four ways of answering "how long will the next one wait".
    # Boxed and side by side rather than run together in the caption, because
    # the point is the comparison -- tight cluster means the queue is in a
    # steady state and the shading can be trusted, spread means it is not.
    if est:
        cards = [("EWMA", f"&alpha;={EWMA_ALPHA}", est["ewma"],
                  "drives the shading", True),
                 ("mean", f"all {est['n']}", est["mean"], "whole history", False),
                 (f"MA({est['k']})", f"last {est['k']}", est["ma"],
                  "recent window", False),
                 ("copy-last", "n = 1", est["last"], "most recent wait", False)]
        est_row = '<div class="estrow">' + "".join(
            f'<div class="estbox{" on" if on else ""}">'
            f'<div class="estk">{k} <span>{sub}</span></div>'
            f'<div class="estv">{esc(S.fmt_dur(v))}</div>'
            f'<div class="estn">{note}</div></div>'
            for k, sub, v, note, on in cards) + "</div>"
    else:
        est_row = ('<div class="estrow"><div class="estbox">'
                   '<div class="estn">no completed jobs in the last 7 days '
                   'to estimate from</div></div></div>')
    btn = (f'<button class="fbtn" data-label="{esc(fc_label)}">{esc(fc_label)}</button>'
           if est else "")
    return (f'<h2>queued <span class="hint">&nbsp;not holding GPUs yet · '
            f'bar spans submission to now &nbsp;·&nbsp; '
            f'<span class="qkey qk-chain"></span>allocation renewal &nbsp;'
            f'<span class="qkey qk-wait"></span>waiting to compute'
            f'</span>{btn}</h2>{est_row}'
            + "".join(rows) + ruler_html(t0, t1, fc_t1, step, lw))



def legend() -> str:
    items = [
        (FILL["full"], "computing, ≥ 80% of allocation"),
        (FILL["mid"], "35 – 80%"),
        (FILL["low"], "< 35%"),
        (FILL["held"], "allocation held, nothing running"),
        (FILL["pending"], "queued, holds no GPU"),
        ((RUN_COLOR, "#5c93c9"), "one continuous run (lanes)"),
        ((BAD_COLOR, "#c97a7a"), "ended abnormally"),
    ]
    return ('<div class="legend">' + "".join(
        f'<span><i style="background:{bg};border-color:{bd}"></i>{esc(t)}</span>'
        for (bg, bd), t in items) + "</div>")


INBOX_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "sgpur", "inbox.json")
# How often -w walks out to the mailbox.  10 s costs 0.036% of one login-node
# core and no filesystem call at all; the felt latency is dominated by the
# republish itself (~40 s) and by Cloudflare KV edge staleness (up to 60 s), so
# polling faster buys nothing visible.
INBOX_POLL = float(os.environ.get("SGPUR_INBOX_POLL", "10"))
# A stuck tab or a double click must not machine-gun sacct and srun.  Keypress
# refreshes are exempt: those are a person, watching, doing it on purpose.
INBOX_MIN_GAP = 20.0
# Backoff after a refused publish.  Answering a refusal with an immediate retry
# is how a transient rate limit turns into a sustained one: on 2026-08-14 this
# loop republished every 30 s for over an hour against a service that was
# saying no, which is the one response guaranteed not to help.  Doubles from
# 30 s, capped at 5 min; a server-named Retry-After always wins over this.
FAIL_BACKOFF_BASE = 30.0
FAIL_BACKOFF_CAP = 300.0
# Stop after this many consecutive failures instead of retrying forever.  At
# the schedule above that is roughly half an hour of trying.
FAIL_STREAK_LIMIT = 8


def read_inbox() -> dict:
    """Where the web page leaves 'please refresh' notes.

    Cloudflare cannot reach login42 -- nothing can, it has no public entrance.
    So the direction is inverted: the page POSTs a timestamp to a Worker, and
    -w walks out to GET it.  The Worker is a mailbox that never knocks.

    The token lives here and in the encrypted half of the page, never in the
    shell, so the set of people who can trigger a refresh is exactly the set
    who can decrypt the page -- no second permission system to keep in sync.
    """
    try:
        with open(INBOX_PATH) as f:
            d = json.load(f)
        if not isinstance(d, dict):
            return {}
        url = d.get("url")
        token = d.get("token")
        if not isinstance(url, str) or not url.startswith("https://"):
            return {}
        if not isinstance(token, str) or not token:
            return {}
        return {"url": url.rstrip("/"), "token": token}
    except (OSError, ValueError):
        return {}


def inbox_get(cfg: dict):
    """Current counter, or None if unset/unreachable.  Never raises: losing
    the mailbox must not take the watch loop down with it."""
    if not cfg.get("url"):
        return None
    try:
        import urllib.request
        req = urllib.request.Request(
            cfg["url"], headers={
                "x-token": cfg.get("token", ""),
                # Cloudflare error 1010 rejects urllib's default signature.
                # Name this tiny client explicitly; no browser impersonation
                # or cookie state is needed for a Worker endpoint.
                "User-Agent": "sgpur/1.0 (+Cloudflare-Worker-mailbox)",
            })
        with urllib.request.urlopen(req, timeout=8) as r:
            value = r.read().decode().strip()
        return value if value.isdecimal() else None
    except Exception:
        return None


def cmd_set_inbox(url: str) -> int:
    url = url.strip().rstrip("/")
    if not url.startswith("https://"):
        print("sgpur --set-inbox: expected an https:// worker url",
              file=sys.stderr)
        return 1
    # read_inbox() gates on `url`, so a token seeded before the Worker existed
    # would read back as {} and be replaced -- silently invalidating the secret
    # already pasted into the dashboard.  Read the file raw.
    try:
        with open(INBOX_PATH) as f:
            stored = json.load(f)
        token = stored.get("token") if isinstance(stored, dict) else None
    except (OSError, ValueError):
        token = None
    token = token or os.environ.get("SGPUR_INBOX_TOKEN", "").strip()
    if not token:
        import getpass
        token = getpass.getpass("Cloudflare Worker TOKEN: ").strip()
    if not token:
        print("sgpur --set-inbox: TOKEN cannot be empty", file=sys.stderr)
        return 1

    # Write atomically with the private mode in force before any secret bytes
    # hit disk.  chmod-after-write leaves a small world-readable window on
    # permissive umasks; NamedTemporaryFile(mode=0600) avoids that window.
    import tempfile
    directory = os.path.dirname(INBOX_PATH)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    tmp = None
    try:
        with tempfile.NamedTemporaryFile(
                "w", dir=directory, prefix=".inbox.", delete=False) as f:
            tmp = f.name
            os.chmod(tmp, 0o600)
            json.dump({"url": url, "token": token}, f, indent=1)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, INBOX_PATH)
        tmp = None
        os.chmod(INBOX_PATH, 0o600)
    finally:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    probe = inbox_get({"url": url, "token": token})
    print(f"inbox set: {url}")
    print(f"  token: stored privately in {INBOX_PATH} (mode 600)")
    print(f"  reachable: {'yes' if probe is not None else 'NO'}")
    if probe is None:
        print("  check the Worker TOKEN matches this private config and that "
              "the KV binding is named KV")
    return 0 if probe is not None else 1


QUOTA_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "sgpur", "quota.json")


def read_quota() -> dict:
    """Grant size and burn rate.

    The allowance and its end date come from the BriCS portal and have to be
    typed in once; consumption comes from `sreport --tres=node`, so the number
    that changes hourly is the one nobody has to maintain.  Everything derived
    below is arithmetic on those two.

    The interesting quantity is not "how much is left" but "how many nodes
    would spend exactly the remainder by the deadline".  An allocation grant
    is use-it-or-lose-it, so running under that figure is a loss that no alarm
    will ever tell you about -- unlike overspending, which errors immediately.
    """
    try:
        with open(QUOTA_PATH) as f:
            q = json.load(f)
    except (OSError, ValueError):
        return {}
    total = float(q.get("total_node_hours") or 0)
    if not total:
        return {}
    used = None
    try:
        p = subprocess.run(
            ["sreport", "-n", "-P", "cluster", "AccountUtilizationByUser",
             f"Account={q.get('account', '')}",
             f"start={q.get('since', '2026-01-01')}", "end=now",
             "--tres=node", "-t", "hours"],
            capture_output=True, text=True, timeout=60)
        for ln in p.stdout.splitlines():
            f = ln.split("|")
            if len(f) >= 6 and f[4] == "node":
                used = max(used or 0.0, float(f[5]))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        used = None
    if used is None:
        used = float(q.get("used_node_hours") or 0)

    end = S.parse_time(q.get("ends", "") + "T23:59:59") if q.get("ends") else None
    days = max(0.0, (end - datetime.now()).total_seconds() / 86400) if end else 0.0
    left = max(0.0, total - used)
    q.update(total=total, used=used, left=left, days=days,
             sustainable=(left / (days * 24) if days > 0 else 0.0))
    return q


GTOP_PATH = os.environ.get("GTOP_PATH", "/projects/public/u6gb/.local/bin/gtop")
_GTOP = None


def load_gtop():
    """gtop's collector, imported the same way sgpu's is."""
    global _GTOP
    if _GTOP is not None:
        return _GTOP
    if not os.path.exists(GTOP_PATH):
        return None
    loader = importlib.machinery.SourceFileLoader("gtopmod", GTOP_PATH)
    spec = importlib.util.spec_from_loader("gtopmod", loader)
    mod = importlib.util.module_from_spec(spec)
    sys.modules["gtopmod"] = mod
    loader.exec_module(mod)
    _GTOP = mod
    return mod


def collect_live(opts):
    """Physical GPU state right now, via gtop's srun probe.

    This is the only part of the page that touches a compute node, and it is
    here because sacct fundamentally cannot answer the question it answers:
    accounting proves a step existed, not that the card was computing.  A
    four-GPU step with three cards sitting at 0% util still bills for four.

    Same mechanism gtop uses, so the same safety properties: --overlap
    --exact with one CPU (never competes with the training step for cores),
    probe delivered over stdin (no Lustre read on the node), process exits
    immediately (no resident agent).
    """
    g = load_gtop()
    if g is None:
        return None, f"gtop not found at {GTOP_PATH}"
    try:
        running, _pending, err = g.discover_jobs(opts.user, None)
    except Exception as exc:
        return None, f"squeue failed: {exc}"
    if err:
        return None, str(err)
    if not running:
        return None, "no running allocation to sample"
    try:
        probe = open(g.PROBE).read()
    except OSError as exc:
        return None, f"probe unreadable: {exc}"
    # gtop truncates each command line at 120 characters, which is fine for a
    # terminal row but loses the experiment name: the identity sits at the end
    # of an absolute path and a conda interpreter path alone can be 74 chars,
    # so rows came back as "python/108865".  Widened in memory only -- the
    # shared probe.sh is not modified, and if that line ever changes this
    # replace simply does nothing and we fall back to the old width.
    probe = probe.replace("cut -c1-120", "cut -c1-400")

    col = g.Collector(probe, timeout=45)
    out = [None] * len(running)

    def one(i, job):
        try:
            out[i] = (job, col.sample_job(job), None)
        except Exception as exc:
            out[i] = (job, {}, str(exc))

    # Cap concurrent srun the way gtop does: holding ten allocations should
    # not mean ten simultaneous step-creation requests at slurmctld.
    with concurrent.futures.ThreadPoolExecutor(
            max_workers=min(len(running), g.MAX_CONCURRENT_SRUN)) as pool:
        list(pool.map(lambda a: one(*a), enumerate(running)))
    return [o for o in out if o], None


def mono(text, width=None, style="norm", tip=None) -> str:
    """One fixed-width cell.  Widths are in ch, matching gtop's format strings,
    so the columns land where they do in the terminal."""
    w = f"width:{width}ch;" if width else ""
    t = f' data-tip="{att(tip)}"' if tip else ""
    # class "m" and not a bare span: the inline-block rule these need must not
    # also hit .lmid / .lgrow, which are spans too and have to stay flex.
    return f'<span class="m s-{style}" style="{w}"{t}>{esc(text)}</span>'


def cbar(frac: float, width=None, style: str = "norm") -> str:
    """The terminal draws these out of block glyphs, so the fill quantises to
    one tenth.  Here it is a div, so it is exact.  width=None lets the parent
    flex slot size it, which is how the bars reach the same right edge as the
    gantt tracks."""
    f = min(max(frac, 0.0), 1.0) * 100
    w = f"width:{width}ch" if width else ""
    return (f'<span class="cbar s-{style}" style="{w}">'
            f'<i style="width:{f:.1f}%"></i></span>')


def live_section(live, err) -> str:
    """gtop's wide layout, column for column.

    Not a redesign: the terminal view is what the user reads every day, and
    every field on it earns its place.  Temperature and wattage are how you
    tell a card that is merely idle from one that is idle and still pulling
    140 W; the process tag is how you tell whose it is.  The only things that
    change here are that the bars are real divs rather than block glyphs, so
    the fill is exact instead of quantised to a tenth, and that hovering any
    row gives the full command line the terminal has to cut off.
    """
    g = _GTOP
    if not live or g is None:
        return (f'<div class="livenote">no live GPU sample: '
                f'{esc(err or "unavailable")}</div>')

    cnt = {"run": 0, "held": 0, "idle": 0}
    tot_gpu = tot_nodes = 0
    wasted_w = 0.0
    for _job, hosts, _e in live:
        tot_nodes += len(hosts)
        for _h, d in hosts.items():
            for gp in d.get("gpus", []):
                tot_gpu += 1
                st = g.gpu_state(gp)
                cnt[st] += 1
                if st != "run":
                    wasted_w += max(0.0, gp.get("pw") or 0.0)

    pct = 100.0 * cnt["run"] / tot_gpu if tot_gpu else 0.0
    head = [mono("gtop  ", None, "hdr"),
            mono(f"{len(live)} alloc · {tot_nodes} nodes · {tot_gpu} GPU",
                 None, "norm"),
            mono("   run ", None, "dim"),
            mono(f"{cnt['run']}/{tot_gpu} ({pct:.0f}%)", None,
                 "hot" if pct >= 50 else ("warn" if pct else "crit"))]
    if cnt["held"]:
        head += [mono("  held ", None, "dim"), mono(str(cnt["held"]), None, "warn")]
    if cnt["idle"]:
        head += [mono("  idle ", None, "dim"), mono(str(cnt["idle"]), None, "crit")]
    if wasted_w > 0:
        head += [mono("   ·  idle draw ", None, "dim"),
                 mono(f"{wasted_w / 1000:.2f} kW", None, "crit")]
    out = [f'<div class="lhead-row">{"".join(head)}</div><div class="lrule"></div>',
           '<div class="lcols"><div class="lbl"></div>'
           '<div class="cap">compute &mdash; cores busy / GPU utilisation</div>'
           '<div class="cap">memory &mdash; host RAM / card memory</div>'
           '<div class="tail spacer"></div></div>']

    for job, hosts, jerr in live:
        left_s = max(0, getattr(job, "left_s", 0))
        # No node/GPU count here: every allocation on this account is 4N 16GPU,
        # and the numbered node rows below state the size anyway.
        jh = [mono(" ▸ job ", None, "dim"), mono(job.jobid, None, "hdr"),
              mono(f"  {job.name}", None, "accent"),
              mono(f"  used {g.fmt_dur(getattr(job, 'used_s', 0))}", None, "dim"),
              mono("  left ", None, "dim"),
              mono(g.fmt_dur(left_s), None, "crit" if left_s < 3600 else "warn")]
        # No step list: whether anything is computing is already visible on
        # the utilisation bars below, card by card, and there it is measured
        # rather than inferred from Slurm's step table.

        # Machine rows carried no GPU information, so they no longer get rows:
        # each node folds into a chip here on the job line, numbered 1-based
        # within its job.  The chip keeps every fact the row had -- cores busy
        # and RAM as mini bars with the exact numbers beside them, load and
        # uptime on hover.
        hostlist = list(getattr(job, "nodes", None) or sorted(hosts))
        for ni, host in enumerate(hostlist, 1):
            jh.append(node_chip(host, hosts.get(host), g, ni))
        out.append(f'<div class="lrow full jobhead">{"".join(jh)}</div>')

        if jerr:
            out.append(f'<div class="lrow full">{mono("     sample failed: ", None, "crit")}'
                       f'{mono(jerr[:120], None, "dim")}</div>')

        # gcount runs 1..N across the whole job, so a card's first column is
        # its overall position (node 2 card 0 -> 5 when nodes hold 4 GPUs).
        gcount = 0
        for ni, host in enumerate(hostlist, 1):
            d = hosts.get(host)
            if d is None:
                continue
            by_uuid = {}
            for p in d.get("procs", []):
                by_uuid.setdefault(p["uuid"], []).append(p)
            for k, gp in enumerate(d.get("gpus", [])):
                gcount += 1
                out.append(gpu_row(host, gp, by_uuid.get(gp["uuid"], []), job, g,
                                   ni, first=(k == 0), gidx=gcount))
        out.append('<div class="lgap"></div>')
    # Every mark this section can print, spelled out.  A colour and a bare
    # session name told the reader nothing about whether it was good news, and
    # the symbols that carried the verdict were the least legible part.
    out.append(
        '<div class="legendbox"><div class="lgtitle">reading this section</div>'
        f'<div class="lgrow"><span class="swpair">'
        f'<i class="swatch" style="background:{NODE_CPU_COLOR};'
        f'border-color:{NODE_CPU_EDGE}"></i>'
        f'<i class="swatch" style="background:{NODE_MEM_COLOR};'
        f'border-color:{NODE_MEM_EDGE}"></i></span>'
        '<span>in a node chip on a <b>job</b> line: the machine\'s cores busy '
        'and RAM used, as mini bars \u2014 hover for load and uptime. Warm '
        'pair, so a machine\'s bars never read as one of its cards\'</span></div>'
        f'<div class="lgrow"><span class="swpair">'
        f'<i class="swatch" style="background:{COMPUTE_COLOR};'
        f'border-color:{COMPUTE_EDGE}"></i></span>'
        '<span>on a <b>card</b> row: GPU utilisation / card memory \u2014 '
        'always this pair, never another colour</span></div>'
        f'<div class="lgrow"><span class="swpair">'
        f'<i class="swatch hatched" '
        f'style="--c:{MEM_COLOR};border-color:{MEM_EDGE}"></i></span>'
        '<span>hatched memory: the card holds it but computes nothing '
        '(<b>held</b>). Same hatch as the queue forecast, and it means the '
        'same thing there \u2014 this length is real, but it is not doing '
        'what a solid bar would be doing</span></div>'
        '<div class="lgsep"></div>'
        '<div class="lgrow"><code>\u2014</code>'
        '<span>in a card\'s name column: no process is on that card at all</span></div>'
        '<div class="lgrow"><code class="warn">held</code>'
        '<span>the card holds memory but computes nothing. Slurm bills it '
        'exactly like a busy card, and the charts above count it as computing, '
        'because accounting cannot tell the two apart</span></div>'
        '<div class="lgrow"><code class="crit">idle</code>'
        '<span>no memory held and nothing computing: genuinely free</span></div>'
        '<div class="lgrow"><code>4/288c</code>'
        '<span>in a node chip: cores busy out of the machine\'s total; the '
        'mini bar left of it is the same number as a fraction</span></div>'
        '<div class="lgrow"><code>5&nbsp; 2[0]</code>'
        '<span>the card\'s overall position within its job (5th of 16), then '
        'card 0 of node 2 — nodes are numbered 1-based within their job, '
        'matching the chips on the job line, and the rule above a card row '
        'marks where a new node starts</span></div>'
        '</div>')
    return f'<div class="lwrap">{"".join(out)}</div>'


def mini(frac: float, fill: str, edge: str) -> str:
    """A very short percentage bar, chip-sized.  Same grammar as every other
    bar on the page -- grey slot is the whole of something, colour is the used
    part -- just 46px of it."""
    w = min(max(frac, 0.0), 1.0) * 100
    return (f'<span class="mini" style="border-color:{edge}">'
            f'<i style="width:{w:.1f}%;background:{fill}"></i></span>')


def node_chip(host, d, g, idx) -> str:
    """One node, folded onto its job's header line.

    A machine row carried no GPU information, yet weighed as much on the page
    as a card row.  Every fact it held survives here: 1-based index and name,
    cores busy and RAM as mini bars against the machine's total with the exact
    numbers beside them ("ten of 288" is the number you can act on, not
    3.5%), and load/uptime in the hover, as before.
    """
    if d is None:
        return (f'<span class="nchip"><span class="nidx">{idx}</span>'
                f'<span class="njid">{esc(host)}</span>'
                f'<span class="m s-crit">no data</span></span>')
    mt, ma = d.get("memtot", 0), d.get("memavl", 0)
    used, tot = (mt - ma) / 1048576.0, mt / 1048576.0
    frac = (mt - ma) / mt if mt else 0.0
    cpu = d.get("cpu", 0.0) or 0.0
    ncpu = d.get("ncpu", 0) or 0
    busy_cores = ncpu * cpu / 100.0
    tip = (f"{host}\ncpu {cpu:.1f}% = {busy_cores:.0f} of {ncpu} cores\n"
           f"RAM {used:.0f} / {tot:.0f} GiB ({frac * 100:.0f}%)\n"
           f"load {d.get('load1', 0):.2f}   up {g.fmt_dur(d.get('up', 0))}")
    return (f'<span class="nchip" data-tip="{att(tip)}">'
            f'<span class="nidx">{idx}</span><span class="njid">{esc(host)}</span>'
            f'{mini(cpu / 100.0, NODE_CPU_COLOR, NODE_CPU_EDGE)}'
            f'<span class="nnum">{busy_cores:.0f}/{ncpu}c</span>'
            f'{mini(frac, NODE_MEM_COLOR, NODE_MEM_EDGE)}'
            f'<span class="nnum">{used:.0f}/{tot:.0f}G</span></span>')


def twin_track(frac: float, fill: str, edge: str, hatch: bool = False) -> str:
    """One of the two side-by-side tracks on a live row.

    Two quantities, two tracks.  Utilisation and memory are independent -- a
    card can hold 90 GiB and compute nothing, which is the whole point of the
    held state -- so folding them into one bar's length and colour, as an
    earlier version did, destroyed the very distinction this section exists
    to show.
    """
    w = min(max(frac, 0.0), 1.0) * 100
    # Hatching, not a different hue: the page already uses a hatch to mean
    # "this length is real but it is not doing what a solid bar would be
    # doing" -- the queue forecast.  Held memory is the same idea, so it gets
    # the same treatment and blue keeps meaning memory everywhere.
    style = (f"background:repeating-linear-gradient(135deg,"
             f"{hex_rgba(fill, .22)} 0 4px,{hex_rgba(fill, .85)} 4px 8px);"
             f"border-color:{edge};border-style:dashed" if hatch
             else f"background:{fill};border-color:{edge}")
    return (f'<div class="track twin"><div class="seg" style="left:0;'
            f'width:{w:.2f}%;{style}"></div></div>')


def gpu_row(host, gp, procs, job, g, ni=None, first=False, gidx=None) -> str:
    u, mu, mt = gp["util"], gp["mused"], gp["mtot"]
    mfrac = mu / mt if mt else 0.0
    st = g.gpu_state(gp)
    us, ms = g.util_style(u), g.mem_style(mfrac)
    pw = gp.get("pw") or 0.0
    # Watts on a card that is not computing is the waste made visible: a held
    # GH200 still pulls 130-150 W doing nothing.
    ps = "crit" if (st != "run" and pw > 60) else "dim"

    tip = (f"{host}  GPU {gp['i']}   {st.upper()}\n"
           f"{gp.get('name', '')}\n"
           f"util {u}%   mem util {gp.get('mutil', 0)}%   {gp['temp']}°C   "
           f"{pw:.0f} W of {gp.get('pl', 0):.0f} W   sm {gp.get('sm', 0)} MHz\n"
           f"mem {mu / 1024:.1f} / {mt / 1024:.1f} GiB ({mfrac * 100:.0f}%)\n"
           f"job {job.jobid}  {job.name}")
    for p in procs:
        tip += (f"\n\n{p.get('user', '?')}  pid {p.get('pid', '?')}  "
                f"rss {p.get('rss', 0) / 1048576.0:.1f} GiB  "
                f"gpu mem {p.get('gmem', 0) / 1024:.1f} GiB\n{p.get('cmd', '')}")

    # Name the experiment, not the interpreter.  "python/75289" is true of
    # almost every row; the command line carries the worktree or tasks
    # directory this card is actually working for, and sgpu already knows how
    # to read an identity out of one -- the same rule the charts below use, so
    # a card here and a lane down there carry the same name.
    tag = "—"
    if procs:
        who = procs[0]
        ident = S.extract_identity(who.get("cmd", ""), "")
        tag = (ident if ident not in (S.UNKNOWN, S.INTERACTIVE)
               else f"{who['comm']}/{who['pid']}")
        if len(procs) > 1:
            tag += f" +{len(procs) - 1}"

    # Length is memory occupied out of the card's own total; colour is whether
    # that memory is doing anything.  Two facts, one bar, no second scale to
    # learn -- and it is the same blue and the same red as the lanes chart.
    # A card's two bars are always green and blue.  held is already stated by
    # the red word on the right, and by the utilisation bar being empty next
    # to a full memory bar -- that shape is the tell.  Recolouring the memory
    # bar as well said it a third time, at the cost of breaking the one rule
    # that makes the section scannable: blue always means memory.
    mfill, medge = MEM_COLOR, MEM_EDGE
    mhatch = st != "run"          # held or idle: occupied, producing nothing
    # With the machine rows folded into chips, the node boundary line moves to
    # each node's first card, and the node's 1-based index prefixes every card
    # ("2[0]" = node 2, card 0) so a row can still be placed without counting.
    # The first column is the card's overall 1..N position within its job.
    ovx = f'<span class="ggidx">{gidx}</span>' if gidx is not None else ""
    nix = f'<span class="nidx">{ni}</span>' if ni is not None else ""
    cls = "row gpu node-top" if first else "row gpu"
    return (f'<div class="{cls}" data-tip="{att(tip)}">'
            f'<div class="lbl idx">{ovx}{nix}<span class="gi">[{gp["i"]}]</span>'
            f'<span class="nm">{esc(tag)}</span></div>'
            f'{twin_track(u / 100.0, COMPUTE_COLOR, COMPUTE_EDGE)}'
            f'{twin_track(mfrac, mfill, medge, mhatch)}'
            f'<div class="tail"><span class="g">{u}%</span>'
            f'<span>{g.fmt_gib(mu)}/{g.fmt_gib(mt)}G</span>'
            + (f'<span class="b">held</span>' if st == "held" else "")
            + (f'<span class="b">idle</span>' if st == "idle" else "")
            + '</div></div>')


FORECAST_FRAC = 0.5     # look-ahead as a fraction of the look-back window


def parse_slurm_dur(text: str):
    """'1-00:00:00' / '24:00:00' / '30:00' -> seconds.  None if unbounded."""
    s = (text or "").strip()
    if not s or s in ("UNLIMITED", "Partition_Limit", "INVALID", "NOT_SET"):
        return None
    days = 0
    if "-" in s:
        d, s = s.split("-", 1)
        days = int(d) * 86400
    try:
        parts = [int(x) for x in s.split(":")]
    except ValueError:
        return None
    while len(parts) < 3:
        parts.insert(0, 0)
    return days + parts[0] * 3600 + parts[1] * 60 + parts[2]


def job_deadlines(jobs) -> dict:
    """When the scheduler will take each allocation away.

    This is the one thing on the page that is not measurement: it is
    start + wall-clock limit, so it is an upper bound.  A job that finishes
    early just stops before its marker.  Worth showing anyway, because the
    question it answers -- "how much of my allocation is left" -- has no
    other source.
    """
    jids = [j.jid for j in jobs if j.base_state == "RUNNING" and j.start]
    if not jids:
        return {}
    try:
        p = subprocess.run(["sacct", "-P", "-n", "-j", ",".join(sorted(jids)),
                            "--format=JobID,Timelimit"],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return {}
    out = {}
    for ln in p.stdout.splitlines():
        f = ln.split("|")
        if len(f) < 2 or "." in f[0]:
            continue
        lim = parse_slurm_dur(f[1])
        if lim:
            out[f[0]] = lim
    return out


LIVE_TOL = 300.0        # a run whose last step ended this recently is "now"


def last_active(h):
    return max((r.end for r in h.runs), default=None)


def sort_hist(hist, now):
    """Most recently active first.

    sgpu sorts by total busy time, which is right for a ledger you read after
    the fact.  On a page you refresh to see what is happening, it buries an
    experiment that started ten minutes ago under one that stopped hours ago:
    measured on real data, two RUNNING experiments sat at rows 14 and 16 while
    row 1 had been dead for twenty minutes.  Nothing is lost by reordering,
    because "who burned the most" is still legible from the GPU-h bars.
    """
    def key(h):
        t = last_active(h)
        return (h.ident in S.NON_EXPERIMENT, -(t.timestamp() if t else 0.0))
    return sorted(hist, key=key)


def live_dot(h, now) -> str:
    t = last_active(h)
    if t is not None and (now - t).total_seconds() <= LIVE_TOL:
        return '<span class="livedot" data-tip="running right now"></span>'
    return ""


def quota_section(q: dict, running: int, pending: int) -> str:
    """The grant, and whether today's footprint will actually spend it."""
    if not q:
        return ""
    pct = q["used"] / q["total"] * 100 if q["total"] else 0
    sust = q["sustainable"]
    proj = running * 24 * q["days"]          # node-hours today's rate will use
    unused = max(0.0, q["left"] - proj)
    short = max(0, round(sust) - running)
    gap = (f'at today\'s <b>{running}</b> node(s) you finish with '
           f'<b>{unused:,.0f}</b> node-h unused '
           f'(<b>{unused / q["total"] * 100:.0f}%</b> of the grant) &nbsp;·&nbsp; '
           f'to spend it all you would need <b>{short}</b> more'
           ) if short > 0 else (
           f'today\'s <b>{running}</b> node(s) are at or above the sustainable '
           f'rate; at this pace the grant runs out '
           f'<b>{q["left"] / max(running * 24, 1):.0f}</b> days before it expires')
    return (
        f'<section><h2>grant <span class="hint">&nbsp;'
        f'{esc(q.get("offering", ""))} · {esc(q.get("account", ""))} · '
        f'ends {esc(q.get("ends", "?"))}</span></h2>'
        f'<div class="kpis">'
        f'<div class="kpi"><div class="v">{q["used"]:,.0f}</div>'
        f'<div class="k">node-h used ({pct:.0f}%)</div></div>'
        f'<div class="kpi"><div class="v">{q["left"]:,.0f}</div>'
        f'<div class="k">node-h left</div></div>'
        f'<div class="kpi"><div class="v">{q["days"]:.0f}</div>'
        f'<div class="k">days remaining</div></div>'
        f'<div class="kpi busy"><div class="v">{sust:.0f}</div>'
        f'<div class="k">nodes sustainable 24/7</div></div>'
        f'<div class="kpi{" idle" if short > 0 else ""}">'
        f'<div class="v">{running}<span class="of">/{sust:.0f}</span></div>'
        f'<div class="k">nodes running now</div></div>'
        f'</div>'
        f'<div class="qbar"><i style="width:{min(pct, 100):.1f}%"></i>'
        f'<u style="left:{min(pct, 100):.1f}%;'
        f'width:{min(proj / q["total"] * 100, 100 - min(pct, 100)):.1f}%"></u></div>'
        f'<div class="qnote">{gap}'
        f'{f" &nbsp;·&nbsp; {pending} node(s) queued" if pending else ""}'
        f'<br><span class="dim">solid = already spent · hatched = what today\'s '
        f'footprint will add by {esc(q.get("ends", "?"))} · '
        f'usage read live from <code>sreport --tres=node</code>, '
        f'allowance from the portal</span></div></section>')


def page_title(opts) -> str:
    return f"GPU time ledger — {opts.user}"


def render_body(snap, opts, live=None, live_err=None) -> str:
    """The sensitive half: everything naming a job, a node, a path, a person.

    Kept separate from the page shell so it can be encrypted as a unit.  The
    shell (CSS, tooltip layer, unlock UI) must stay free of anything that
    identifies the cluster or the user, because the shell is what an
    unauthenticated visitor downloads.
    """
    t0, t1 = snap.t0, snap.t1
    span_s = (t1 - t0).total_seconds()
    step = tick_step(span_s)
    snap.hist = sort_hist(snap.hist, snap.now)
    fc_t1 = t1 + timedelta(seconds=span_s * FORECAST_FRAC)
    deadlines = job_deadlines(snap.live)
    fc_label = f"+{fmt_span(span_s * FORECAST_FRAC)} forecast"
    quota = read_quota()
    run_nodes = sum(j.nodes for j in snap.live if j.base_state == "RUNNING")
    pend_nodes = sum(j.nodes for j in snap.pending)

    alloc = busy = 0.0
    for j in snap.live:
        for sg in j.segments:
            if sg.kind == "pending":
                continue
            alloc += gh(sg.secs, sg.alloc_gpus)
            if sg.kind == "busy":
                busy += gh(sg.secs, sg.gpus)
    idle = alloc - busy
    ratio = busy / alloc * 100 if alloc else 0.0

    # The url and token ride inside the encrypted half, so the set of people who
    # can ask for a refresh is exactly the set who can read the page.
    #
    # A button, and deliberately not the browser's own reload gesture.  Cmd+R
    # means "show me this page again"; it is how you re-read what is already
    # here, and it also fires for a bookmark, a restored tab and the back
    # button.  Hanging one sacct and one srun off it makes re-reading cost a
    # cluster sample, which is the opposite of what the gesture means.  A click
    # on a button that says refresh has exactly one reading.
    ib = read_inbox()
    rbtn = ("" if not ib.get("url") else
            f'<button class="rbtn" id="rbtn" data-url="{att(ib["url"])}"'
            f' data-token="{att(ib.get("token", ""))}"'
            f' data-label="↻ refresh"'
            f' title="ask the terminal running `sgpur -w` to resample and'
            f' republish; the page reloads itself when it lands">'
            f'↻ refresh</button>')

    lane_lw = 250
    job_lw = 250
    sess_names = session_map({h.ident for h in snap.hist
                              if h.ident not in S.NON_EXPERIMENT})
    tzabbr = L(snap.now).strftime("%Z")          # BST or GMT, whichever applies
    title = page_title(opts)
    scope = f"jobs {', '.join(opts.job)}" if opts.job else "all jobs"

    body = f"""<div class="band b-live"><div class="wrap">
<header>
  <h1>{esc(title)}</h1>
  <div class="sub">
    {L(t0):%Y-%m-%d %H:%M} → {L(t1):%Y-%m-%d %H:%M} {esc(tzabbr)}
    &nbsp;·&nbsp; window <b>{esc(opts.window)}</b>
    &nbsp;·&nbsp; {esc(scope)}
    &nbsp;·&nbsp; snapshot <span id="age">just now</span>{rbtn}
  </div>
  <div class="srch">
    <input id="q" type="search" spellcheck="false" autocomplete="off"
      placeholder="search jobs, experiments, nodes, command lines&hellip;   space = AND,  -word = exclude">
    <span class="n" id="qn"></span><kbd>/</kbd>
  </div>
  <div class="kpis">
    <div class="kpi"><div class="v">{alloc:,.0f}</div><div class="k">GPU-h allocated</div></div>
    <div class="kpi busy"><div class="v">{busy:,.0f}</div><div class="k">computed ({ratio:.1f}%)</div></div>
    <div class="kpi idle"><div class="v">{idle:,.0f}</div><div class="k">GPU-h idle</div></div>
    <div class="kpi"><div class="v">{len(snap.live)}</div><div class="k">allocations</div></div>
    <div class="kpi"><div class="v">{len(snap.hist)}</div><div class="k">experiments</div></div>
    <div class="kpi clock"><div class="v" id="clock">--:--:--</div>
      <div class="k">{esc(str(DISPLAY_TZ))} · {esc(tzabbr)}</div></div>
  </div>
</header>

{quota_section(quota, run_nodes, pend_nodes)}
</div></div>

<div class="band b-charts"><div class="wrap">
<section>
  <h2>allocations <span class="hint">&nbsp;one row per job · fill = share of its GPUs actually computing</span>
    <button class="fbtn" data-label="{esc(fc_label)}">{esc(fc_label)}</button></h2>
  {overview_section(snap, t0, t1, fc_t1, step, job_lw, deadlines)}
  {ruler_html(t0, t1, fc_t1, step, job_lw)}
</section>

<section>
  <h2>experiments <span class="hint">&nbsp;one row per identity, across jobs · the holes are the breaks</span></h2>
  {lanes_section(snap, t0, t1, step, lane_lw, sess_names)}
  {ruler_html(t0, t1, fc_t1, step, lane_lw)}
  {legend()}
</section>

<section>
  <details class="secfold">
  <summary><h2><span class="arr">▸</span>restart history <span class="hint">&nbsp;one row per identity · each block is one run · hover for exact times · folded, click to open</span></h2></summary>
  {history_chart(snap, t0, t1, step, opts.window)}
  </details>
</section>

</div></div>

<div class="band b-detail"><div class="wrap">
{pending_block(snap, t0, t1, fc_t1, step, job_lw, opts.user, fc_label)}
<section>
  <h2>live GPUs <span class="hint">&nbsp;physical utilisation right now, read off the cards themselves · the only measurement here that does not come from accounting</span></h2>
  {live_section(live, live_err)}
</section>


<section>
  <h2>segments <span class="hint">&nbsp;exact times and full command lines</span></h2>
  {segments_detail(snap)}
</section>

<footer>
  Ground truth: Slurm accounting only (<code>sacct</code>), no node was touched.
  <b>allocated</b> counts wall time × GPUs the scheduler handed over;
  <b>computed</b> counts only intervals where a step longer than
  {opts.min_step:.0f}s actually held those GPUs. The difference is waste.
  <code>.batch</code>/<code>.extern</code> excluded, {snap.dropped} probe steps
  under {opts.min_step:.0f}s filtered, concurrent steps clipped to the allocation
  rather than summed. A step counts as one continuous run until a gap of
  {opts.gap:.0f}s.
  Every time on this page is <b>{esc(str(DISPLAY_TZ))}</b> ({esc(tzabbr)}), converted
  from the {esc(time.strftime('%Z'))} that the scheduler records, including the
  axis ticks, which sit on {esc(tzabbr)} wall-clock boundaries rather than on
  {esc(time.strftime('%Z'))} ones.
  This page is a snapshot, not a live feed: re-run
  <code>sgpur</code> to refresh it.
</footer>
</div></div>"""
    return body


# --- page assembly, locked or plain ---------------------------------------

GATE_CSS = """
